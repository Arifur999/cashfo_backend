# Server
PORT=5000
NODE_ENV=development
ADMIN_FRONTEND_URL=http://localhost:3000
# Where customers sign in -- UserAuthService.forgotPassword() builds the
# emailed reset link (<url>/reset-password?token=...) from it. The admin
# panel and the customer pages are one site now, so it is the same origin.
USER_FRONTEND_URL=http://localhost:3000

# Which proxies in front of this API to trust for X-Forwarded-For (Express
# "trust proxy"): true/false, a hop count, "loopback", an IP/CIDR or a comma
# list. The default "loopback" fits the usual setup -- nginx and the
# frontends on this machine calling via localhost -- and makes req.ip the
# real client for login throttling, Login Monitoring and the audit log. The
# proxy that faces the internet must append the client address
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
TRUST_PROXY=loopback

# Database (PostgreSQL). For local dev without Docker/a local Postgres
# install, run `npx prisma dev -d` from backend/ -- it prints a ready-to-use
# connection string; use that here. That instance is local-only and never
# works from a deployed host -- point this at a real hosted Postgres
# (Neon/Supabase/Railway/Render Postgres/etc) for staging/production, and
# use `prisma migrate deploy` there instead of `db push`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_panel?schema=public"

# better-auth (src/auth) -- one identity for admins and end users. It checks
# passwords, keeps the sessions the app's JWTs below are bound to, and runs
# Google sign-in. BETTER_AUTH_SECRET signs its cookies: generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# The public origin /api/auth is reached on. In production that is the site
# itself (https://smartly.softech.agency), with /api/auth/* routed to this
# backend; locally this backend's own URL works for everything but Google.
BETTER_AUTH_URL=http://localhost:5000

# Google sign-in -- off unless both are set. The OAuth client's authorized
# redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push for Habit Tracker reminders (src/push) -- off unless all three
# are set; the bell gets every reminder either way. Make a key pair once with
# `npx web-push generate-vapid-keys` and keep it: changing it orphans every
# device that subscribed with the old public key. VAPID_SUBJECT is a contact
# the push services can reach, a mailto: or https: address
# (e.g. mailto:support@example.com).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 1 stops the reminder scheduler (RemindersScheduler) in this process; it is
# also off whenever NODE_ENV=test.
REMINDERS_DISABLED=
# 1 stops the five-minute housekeeping timer (src/housekeeping: lapsed
# checkouts, plans whose period or trial ran out, referral commissions
# leaving their refund window, old one-time codes, deleted accounts whose
# 30 days are up) in this process; it is
# also off whenever NODE_ENV=test. Safe on several servers at once -- a
# Postgres advisory lock lets one run each tick -- and everything it does
# also happens when a customer opens their billing page, so turning it off
# only delays the tidying for everyone else.
HOUSEKEEPING_DISABLED=

# Better Auth Infra dashboard (dash.better-auth.com) -- off unless set. The
# dashboard reaches this backend at <BETTER_AUTH_URL>/api/auth/dash/*, so it
# only connects to a deployed, publicly reachable instance.
BETTER_AUTH_API_KEY=

# JWT (admin auth) -- each token carries the better-auth session id (sid),
# so ending the session ends the token.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT (end-user app auth, User model) -- separate secrets from the admin ones
# above, so an admin token can never be replayed against end-user routes.
USER_JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
USER_JWT_ACCESS_EXPIRES_IN=15m
USER_JWT_REFRESH_EXPIRES_IN=7d

# Shared-secret header key the end-user analytics tracking endpoint checks
# (backend/src/analytics/guards/tracking-api-key.guard.ts) -- any random string.
USAGE_TRACKING_API_KEY=replace-with-a-long-random-secret

# Settings > Password Manager (VaultEntry). VAULT_ENCRYPTION_KEY MUST be a
# 64-character hex string (32 bytes) -- generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# VAULT_TOKEN_SECRET signs the short-lived vault-unlock token, kept separate
# from USER_JWT_SECRET on purpose.
VAULT_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
VAULT_TOKEN_SECRET=replace-with-a-long-random-secret
VAULT_TOKEN_EXPIRES_IN=10m

# Two-step sign-in (src/two-step), for customers and admins. The
# authenticator-app secrets are sealed with TWO_FACTOR_ENCRYPTION_KEY (a
# 64-character hex string, generated like VAULT_ENCRYPTION_KEY); left empty,
# VAULT_ENCRYPTION_KEY is used. Changing it later makes every account set
# two-step up again, so pick one and keep it. TWO_STEP_SECRET signs the
# five-minute "code still to come" token between the password and the code;
# left empty, one is derived from JWT_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_STEP_SECRET=

# Image uploads (User.avatarUrl, Contact.photoUrl) -- get a free key at
# https://api.imgbb.com/.
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Transactional email (welcome email on register, etc.) -- see MailService.
# Get a key at https://resend.com/api-keys. MAIL_FROM must stay
# onboarding@resend.dev (Resend's shared test sender) until you verify your
# own sending domain at https://resend.com/domains.
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM=onboarding@resend.dev
# Referral withdrawals are confirmed with a six-digit code, sent by SMS to a
# verified phone when SMS is set up, by email otherwise (src/one-time-codes). Development only: with
# OTP_DEV_LOG=1 and no RESEND_API_KEY, the code (and the link of an admin
# invite, an admin password reset or an email verification) is written to the server log
# instead of being sent, so the flow can be tried locally. Ignored when
# NODE_ENV=production.
OTP_DEV_LOG=

# Text SMS through MRAM (https://msg.mram.com.bd > Developers API): one-time
# codes, phone verification and the password reset by phone. Off until both
# are set. SMS_SENDER_ID is the approved sender id from the MRAM panel. If
# MRAM answers 1016, allow this server's IP address in the panel.
SMS_API_KEY=
SMS_SENDER_ID=
