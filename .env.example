# Server
PORT=5000
NODE_ENV=development
ADMIN_FRONTEND_URL=http://localhost:3000
# user-frontend is never called by CORS (see CLAUDE.md -- both frontends only
# reach this backend server-side), but UserAuthService.forgotPassword() needs
# to know its origin to build the emailed reset link.
USER_FRONTEND_URL=http://localhost:3001

# Which proxies in front of this API to trust for X-Forwarded-For (Express
# "trust proxy"): true/false, a hop count, "loopback", an IP/CIDR or a comma
# list. The default "loopback" fits the usual setup -- nginx and the
# frontends on this machine calling via localhost -- and makes req.ip the
# real client for login throttling, Login Monitoring and the audit log. The
# proxy that faces the internet must append the client address
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
TRUST_PROXY=loopback

# Database (PostgreSQL). For local dev without Docker/a local Postgres
# install, run `npx prisma dev -d` from backend/ -- it prints a ready-to-use
# connection string; use that here. That instance is local-only and never
# works from a deployed host -- point this at a real hosted Postgres
# (Neon/Supabase/Railway/Render Postgres/etc) for staging/production, and
# use `prisma migrate deploy` there instead of `db push`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_panel?schema=public"

# better-auth (src/auth) -- one identity for admins and end users. It checks
# passwords, keeps the sessions the app's JWTs below are bound to, and runs
# Google sign-in. BETTER_AUTH_SECRET signs its cookies: generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# The public origin /api/auth is reached on. In production that is the site
# itself (https://smartly.softech.agency), with /api/auth/* routed to this
# backend; locally this backend's own URL works for everything but Google.
BETTER_AUTH_URL=http://localhost:5000

# Google sign-in -- off unless both are set. The OAuth client's authorized
# redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Infra dashboard (dash.better-auth.com) -- off unless set. The
# dashboard reaches this backend at <BETTER_AUTH_URL>/api/auth/dash/*, so it
# only connects to a deployed, publicly reachable instance.
BETTER_AUTH_API_KEY=

# JWT (admin auth) -- each token carries the better-auth session id (sid),
# so ending the session ends the token.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT (end-user app auth, User model) -- separate secrets from the admin ones
# above, so an admin token can never be replayed against end-user routes.
USER_JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
USER_JWT_ACCESS_EXPIRES_IN=15m
USER_JWT_REFRESH_EXPIRES_IN=7d

# Shared-secret header key the end-user analytics tracking endpoint checks
# (backend/src/analytics/guards/tracking-api-key.guard.ts) -- any random string.
USAGE_TRACKING_API_KEY=replace-with-a-long-random-secret

# Settings > Password Manager (VaultEntry). VAULT_ENCRYPTION_KEY MUST be a
# 64-character hex string (32 bytes) -- generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# VAULT_TOKEN_SECRET signs the short-lived vault-unlock token, kept separate
# from USER_JWT_SECRET on purpose.
VAULT_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
VAULT_TOKEN_SECRET=replace-with-a-long-random-secret
VAULT_TOKEN_EXPIRES_IN=10m

# Image uploads (User.avatarUrl, Contact.photoUrl) -- get a free key at
# https://api.imgbb.com/.
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Transactional email (welcome email on register, etc.) -- see MailService.
# Get a key at https://resend.com/api-keys. MAIL_FROM must stay
# onboarding@resend.dev (Resend's shared test sender) until you verify your
# own sending domain at https://resend.com/domains.
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM=onboarding@resend.dev
