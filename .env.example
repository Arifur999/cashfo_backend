# Server
PORT=5000
NODE_ENV=development
ADMIN_FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL). For local dev without Docker/a local Postgres
# install, run `npx prisma dev -d` from backend/ -- it prints a ready-to-use
# connection string; use that here. Against a real persistent Postgres
# (staging/production), use `prisma migrate deploy` instead of `db push`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_panel?schema=public"

# JWT (admin auth)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT (end-user app auth, User model) -- separate secrets from the admin ones
# above, so an admin token can never be replayed against end-user routes.
USER_JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
USER_JWT_ACCESS_EXPIRES_IN=15m
USER_JWT_REFRESH_EXPIRES_IN=7d
