# Server
PORT=5000
NODE_ENV=development
ADMIN_FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL). For local dev without Docker/a local Postgres
# install, run `npx prisma dev -d` from backend/ -- it prints a ready-to-use
# connection string; use that here. That instance is local-only and never
# works from a deployed host -- point this at a real hosted Postgres
# (Neon/Supabase/Railway/Render Postgres/etc) for staging/production, and
# use `prisma migrate deploy` there instead of `db push`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_panel?schema=public"

# JWT (admin auth)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT (end-user app auth, User model) -- separate secrets from the admin ones
# above, so an admin token can never be replayed against end-user routes.
USER_JWT_SECRET=replace-with-a-long-random-secret
USER_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
USER_JWT_ACCESS_EXPIRES_IN=15m
USER_JWT_REFRESH_EXPIRES_IN=7d

# Shared-secret header key the end-user analytics tracking endpoint checks
# (backend/src/analytics/guards/tracking-api-key.guard.ts) -- any random string.
USAGE_TRACKING_API_KEY=replace-with-a-long-random-secret

# Settings > Password Manager (VaultEntry). VAULT_ENCRYPTION_KEY MUST be a
# 64-character hex string (32 bytes) -- generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# VAULT_TOKEN_SECRET signs the short-lived vault-unlock token, kept separate
# from USER_JWT_SECRET on purpose.
VAULT_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
VAULT_TOKEN_SECRET=replace-with-a-long-random-secret
VAULT_TOKEN_EXPIRES_IN=10m

# Image uploads (User.avatarUrl, Contact.photoUrl) -- get a free key at
# https://api.imgbb.com/.
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Transactional email (welcome email on register, etc.) -- see MailService.
# Get a key at https://resend.com/api-keys. MAIL_FROM must stay
# onboarding@resend.dev (Resend's shared test sender) until you verify your
# own sending domain at https://resend.com/domains.
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM=onboarding@resend.dev
