generator client {
  provider = "prisma-client-js"
}

// Prisma 7: no `url` here -- the connection string lives in prisma.config.ts
// (for the CLI/migrations) and is passed explicitly as a driver adapter to
// the PrismaClient constructor at runtime (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// --- Admin domain only for now. End-user tables (transactions, accounts, etc.)
// come later in the separate user-app build plan. ---

model AdminUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdBy    String? // loose reference to the AdminUser (usually SUPER_ADMIN) who created this account, if any
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]

  // Note: no separate @@index([email]) here -- @unique already creates a
  // unique index covering lookups by email, so a second index would be
  // redundant.
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AuditLog {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String // e.g. "ADMIN_LOGIN", "USER_SUSPENDED", "PLAN_UPDATED"
  entityType  String // e.g. "AdminUser", "PlatformUser", "SubscriptionPlan"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// --- Prompt 2: User Management (admin's view of the SaaS's platform users,
// not the end-user app's own data model). When the real end-user app schema
// is built later (separate 20-prompt plan), this model will either be merged
// into it or referenced from it. `plan` already points at the real
// SubscriptionPlan model (added in Prompt 3) rather than a placeholder stub. ---

model PlatformUser {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  phone           String?
  status          PlatformUserStatus @default(ACTIVE)
  planId          String?
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id])
  workspaceCount  Int                @default(1)
  signupSource    String? // e.g. "web", "referral"
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // No separate @@index([email]) -- @unique above already covers it.
  @@index([status])
  @@index([createdAt])
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

// --- Prompt 3: Subscriptions (plans, coupons, and plan-change history). ---

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String // e.g. "Free", "Monthly Pro", "Yearly Pro", "Business"
  slug          String             @unique // e.g. "free", "monthly-pro"
  billingCycle  BillingCycle
  price         Decimal            @db.Decimal(10, 2)
  currency      String             @default("BDT")
  trialDays     Int                @default(0)
  isActive      Boolean            @default(true)
  featureLimits Json // e.g. { "maxWorkspaces": 1, "maxBusinessWorkspaces": 0, "maxTransactionsPerMonth": 100, "advancedReports": false, "pdfExport": false, "multiUser": false }
  displayOrder  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         PlatformUser[]
  couponUsages  CouponRedemption[]
  payments      Payment[]
  businesses    Business[] // end-user app (Prompt 1): workspaces on this plan
}

enum BillingCycle {
  FREE
  MONTHLY
  YEARLY
}

model Coupon {
  id              String             @id @default(uuid())
  code            String             @unique
  discountType    DiscountType
  discountValue   Decimal            @db.Decimal(10, 2)
  maxRedemptions  Int? // null = unlimited
  timesRedeemed   Int                @default(0)
  validFrom       DateTime
  validUntil      DateTime
  applicablePlans String[] // array of SubscriptionPlan.id, empty = applies to all
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  redemptions     CouponRedemption[]
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CouponRedemption {
  id             String           @id @default(uuid())
  couponId       String
  coupon         Coupon           @relation(fields: [couponId], references: [id])
  platformUserId String
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  redeemedAt     DateTime         @default(now())
}

model PlanChangeLog {
  id             String   @id @default(uuid())
  platformUserId String
  fromPlanId     String?
  toPlanId       String
  changedBy      String // AdminUser id, or "SYSTEM" if automated
  reason         String?
  createdAt      DateTime @default(now())
}

// --- Prompt 4: Payments (payments, invoices, refunds). ---

model Payment {
  id                 String           @id @default(uuid())
  platformUserId     String
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  amount             Decimal          @db.Decimal(10, 2)
  currency           String           @default("BDT")
  discountApplied    Decimal?         @db.Decimal(10, 2)
  couponId           String?
  gateway            PaymentGateway
  gatewayReferenceId String? // transaction id from bKash/SSLCommerz/etc, nullable until real integration
  status             PaymentStatus
  failureReason      String?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  invoice            Invoice?
  refund             Refund?

  @@index([platformUserId, createdAt])
  @@index([status])
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Invoice {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  invoiceNumber String   @unique // e.g. INV-2026-000123, auto-generated sequential
  issuedTo      String // snapshot of user name/email at time of invoice
  lineItems     Json // [{ description, amount }]
  totalAmount   Decimal  @db.Decimal(10, 2)
  pdfUrl        String? // populated later when PDF generation is added
  createdAt     DateTime @default(now())
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  processedBy String // AdminUser id
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

// --- Prompt 5: Content Management (default chart-of-accounts/category
// templates seeded into new workspaces, i18n strings, announcements, legal
// docs). ---

model DefaultAccountTemplate {
  id             String                   @id @default(uuid())
  name           String // e.g. "Cash", "Bank", "Sales Income", "Rent Expense"
  nameBn         String // Bangla translation
  accountType    AccountType
  accountSubtype String? // e.g. "cash", "bank", "mfs", "receivable", "payable"
  parentId       String?
  parent         DefaultAccountTemplate?  @relation("ParentChild", fields: [parentId], references: [id])
  children       DefaultAccountTemplate[] @relation("ParentChild")
  appliesTo      WorkspaceType[] // which workspace types get this by default: PERSONAL, BUSINESS
  displayOrder   Int                      @default(0)
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  categories     DefaultCategory[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
  // Mess/joint-family "Group Expense" workspace -- see the GroupMember/
  // GroupContribution/GroupExpense/GroupSettlement models near the end of
  // this file for why it's a separate, much simpler ledger rather than
  // reusing Account/Transaction.
  GROUP
}

model DefaultCategory {
  id                      String                  @id @default(uuid())
  name                    String
  nameBn                  String
  type                    CategoryDirection // INCOME or EXPENSE
  icon                    String? // icon identifier string, e.g. "utensils", "car"
  linkedAccountTemplateId String?
  linkedAccountTemplate   DefaultAccountTemplate? @relation(fields: [linkedAccountTemplateId], references: [id])
  isActive                Boolean                 @default(true)
  displayOrder            Int                     @default(0)
}

enum CategoryDirection {
  INCOME
  EXPENSE
}

model TranslationString {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "dashboard.total_income"
  en        String
  bn        String
  context   String? // e.g. "dashboard", "auth", "reports" -- for grouping in the admin UI
  updatedAt DateTime @updatedAt
  updatedBy String? // AdminUser id
}

model Announcement {
  id         String           @id @default(uuid())
  title      String
  titleBn    String?
  body       String
  bodyBn     String?
  type       AnnouncementType
  targetPlan String? // SubscriptionPlan.id, null = all users
  startAt    DateTime
  endAt      DateTime?
  isActive   Boolean          @default(true)
  createdBy  String // AdminUser id
  createdAt  DateTime         @default(now())
}

enum AnnouncementType {
  INFO
  WARNING
  PROMOTION
  MAINTENANCE
}

model LegalDocument {
  id        String       @id @default(uuid())
  type      LegalDocType @unique
  contentEn String       @db.Text
  contentBn String?      @db.Text
  version   Int          @default(1)
  updatedAt DateTime     @updatedAt
  updatedBy String?
}

enum LegalDocType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  REFUND_POLICY
  FAQ
}

// --- Prompt 6: Support (tickets, ticket messages, feature requests + votes). ---

model SupportTicket {
  id                String          @id @default(uuid())
  platformUserId    String
  subject           String
  category          TicketCategory
  priority          TicketPriority  @default(MEDIUM)
  status            TicketStatus    @default(OPEN)
  assignedToAdminId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resolvedAt        DateTime?
  messages          TicketMessage[]

  @@index([status, priority])
  @@index([platformUserId])
}

enum TicketCategory {
  BILLING
  TECHNICAL
  ACCOUNT
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id])
  senderType    SenderType
  senderId      String // AdminUser id or PlatformUser id depending on senderType
  message       String        @db.Text
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum SenderType {
  ADMIN
  USER
}

model FeatureRequest {
  id             String               @id @default(uuid())
  platformUserId String
  title          String
  description    String               @db.Text
  status         FeatureRequestStatus @default(SUBMITTED)
  voteCount      Int                  @default(1)
  createdAt      DateTime             @default(now())
}

enum FeatureRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model FeatureRequestVote {
  id               String   @id @default(uuid())
  featureRequestId String
  platformUserId   String
  createdAt        DateTime @default(now())

  @@unique([featureRequestId, platformUserId])
}

// --- Prompt 7: Analytics (raw usage events + rolled-up daily snapshots). ---

model UsageEvent {
  id             String     @id @default(uuid())
  platformUserId String
  eventType      String // e.g. "income_added", "expense_added", "report_viewed", "budget_created", "login"
  metadata       Json? // flexible extra data, e.g. { "reportType": "profit_loss" }
  deviceType     DeviceType
  country        String? // for geographic breakdown
  city           String?
  createdAt      DateTime   @default(now())

  @@index([platformUserId, createdAt])
  @@index([eventType])
  @@index([country])
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

model DailyActiveSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  dailyActive Int
  newSignups  Int
  totalUsers  Int
  createdAt   DateTime @default(now())
}

// --- Prompt 8: Security & Audit (login attempts, suspicious activity flags). ---

model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String? // e.g. "invalid_password", "account_suspended", "rate_limited"
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SuspiciousActivityFlag {
  id             String                 @id @default(uuid())
  type           SuspiciousActivityType
  description    String
  relatedAdminId String?
  relatedIp      String?
  severity       Severity               @default(MEDIUM)
  status         FlagStatus             @default(OPEN)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())

  @@index([status, severity])
}

enum SuspiciousActivityType {
  MULTIPLE_FAILED_LOGINS
  UNUSUAL_LOGIN_LOCATION
  MASS_DATA_ACCESS
  IMPERSONATION_SPIKE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FlagStatus {
  OPEN
  REVIEWING
  RESOLVED
  FALSE_POSITIVE
}

// --- Prompt 9: System/Technical Management (backups, feature flags, error
// logs, API rate-limit monitoring). Everything here is simulated/manual-
// trigger rather than wired to real infrastructure -- see the module-level
// comment in system.module.ts for what's a stand-in vs. production-ready. ---

model BackupRecord {
  id           String       @id @default(uuid())
  triggeredBy  String // AdminUser id, or "SYSTEM" for scheduled
  type         BackupType
  status       BackupStatus
  sizeMb       Float?
  fileLocation String? // placeholder path/URL, real storage wiring comes later
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@index([startedAt])
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // e.g. "new_dashboard_ui", "ai_categorization_beta"
  name           String
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0) // 0-100, for gradual rollout
  targetPlanIds  String[] // empty = all plans
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

model ErrorLog {
  id         String      @id @default(uuid())
  source     ErrorSource
  message    String
  stackTrace String?     @db.Text
  severity   Severity // reused from Prompt 8 -- same schema file
  metadata   Json?
  resolved   Boolean     @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([resolved, severity])
  @@index([source, createdAt])
}

enum ErrorSource {
  BACKEND_API
  ADMIN_FRONTEND
  BACKGROUND_JOB
}

model ApiRateLimitLog {
  id             String   @id @default(uuid())
  endpoint       String
  windowStart    DateTime
  requestCount   Int
  limitExceeded  Boolean  @default(false)
  identifierType String // "ip" or "admin" or "platform_user"
  identifier     String

  @@index([endpoint, windowStart])
  @@index([limitExceeded])
}

// --- Prompt 10: Notification Management. Sending is simulated -- no real
// email/SMS/push provider is wired up yet, see notifications.module.ts. ---

model NotificationTemplate {
  id        String              @id @default(uuid())
  key       String              @unique // e.g. "subscription_expiring", "payment_failed", "welcome"
  channel   NotificationChannel
  subjectEn String? // for email
  subjectBn String?
  bodyEn    String              @db.Text
  bodyBn    String              @db.Text
  variables String[] // e.g. ["userName", "planName", "expiryDate"] -- documents what {{placeholders}} are available
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP_PUSH
}

model NotificationLog {
  id             String                @id @default(uuid())
  platformUserId String
  templateKey    String
  channel        NotificationChannel
  status         NotificationLogStatus
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())

  @@index([platformUserId, createdAt])
  @@index([templateKey])
}

enum NotificationLogStatus {
  QUEUED
  SENT
  FAILED
}

model BulkNotificationCampaign {
  id           String              @id @default(uuid())
  title        String
  templateKey  String
  targetFilter Json // e.g. { "planId": "xxx", "status": "ACTIVE" } -- describes who it goes to
  channel      NotificationChannel
  status       CampaignStatus      @default(DRAFT)
  scheduledFor DateTime?
  sentCount    Int                 @default(0)
  failedCount  Int                 @default(0)
  createdBy    String
  createdAt    DateTime            @default(now())
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// =====================================================================
// END-USER APP (separate 20-prompt plan). Same database/schema file as
// the admin panel above -- extended here, not forked. Prompt 1: identity
// (User) + workspace (Business/BusinessMember) only. Account/Transaction/
// Contact tables come in later prompts.
// =====================================================================

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  // Uploaded via POST /api/auth/avatar (same local-disk multer pattern as
  // Contact.photoUrl -- see contact-photo-upload.ts's comment), served back
  // statically from /uploads/avatars. Null shows the initials-circle
  // fallback in the UI instead.
  avatarUrl         String?
  passwordHash      String
  // Shareable short code for this user's own referral link ("Referral
  // Program" menu) -- nullable because pre-existing users only get one
  // lazily backfilled the first time they open that page (see
  // ReferralsService.getReferralInfo()); every brand-new registration sets
  // one immediately (see UserAuthService.register()). Unique so a code
  // uniquely identifies its owner when a new signup's referralCode DTO
  // field is looked up.
  referralCode      String?            @unique
  // Settings > Password Manager's own unlock secret -- deliberately separate
  // from passwordHash above (a leaked account password must not also unlock
  // the vault). Null until the user completes first-time vault setup (see
  // PasswordVaultService.setVaultPassword()); the vault menu shows a "Set up"
  // prompt instead of an unlock form until then.
  vaultPasswordHash String?
  preferredLanguage LanguagePreference @default(EN)
  status            UserStatus         @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       BusinessMember[]
  ownedBusinesses   Business[]         @relation("BusinessOwner")
  sessions          UserSession[]
  vaultEntries      VaultEntry[]
  // Every Referral row this user created by inviting someone else (as the
  // referrer), vs. the single Referral row recording that this user was
  // THEMSELVES referred by someone else's code at registration.
  referralsMade     Referral[]         @relation("Referrer")
  referredAs        Referral?          @relation("Referred")

  // No separate @@index([email]) -- @unique above already creates a unique
  // index covering lookups by email (same reasoning as AdminUser/PlatformUser).
}

// Settings > Security > Device Management -- one row per issued refresh
// token (see UserAuthService.signRefreshToken()'s jti), created at login/
// register and updated on every refresh call. This is what makes session
// revocation actually persist (the in-memory TokenBlacklistService alone is
// lost on restart, see its own comment) -- revokeSession() sets revokedAt,
// and refresh() rejects a refresh token whose session is revoked, on top of
// the existing in-memory check. deviceLabel/userAgent/ipAddress are
// snapshotted at login time, never updated afterward, even if lastUsedAt
// moves -- a session is still "the same device" for display purposes even
// if e.g. its IP changes on a later refresh.
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  jti         String    @unique
  deviceLabel String
  ipAddress   String
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
}

// A personal credential vault -- "Password Manager" menu (client's own
// Facebook/bank/etc. logins, unrelated to this app's own accounting data).
// passwordCiphertext is reversible (AES-256-GCM via vault-crypto.ts), NOT a
// bcrypt hash -- the whole point is the user can view it again, unlike an
// account password. Every route touching this model requires BOTH
// UserAuthGuard (real login) and VaultAccessGuard (a short-lived vault
// token from POST /api/vault/unlock) -- see password-vault.module.ts.
model VaultEntry {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  title              String
  category           VaultEntryCategory @default(OTHER)
  websiteUrl         String?
  // The account HOLDER's real name (e.g. a bank account's registered
  // name) -- distinct from usernameOrEmail below, which is the login
  // credential itself. Both optional since not every entry has both.
  holderName         String?
  usernameOrEmail    String?
  passwordCiphertext String
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
}

enum VaultEntryCategory {
  SOCIAL
  BANK
  EMAIL
  SHOPPING
  WORK
  OTHER
}

enum LanguagePreference {
  EN
  BN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Business {
  id           String            @id @default(uuid())
  ownerId      String
  owner        User              @relation("BusinessOwner", fields: [ownerId], references: [id])
  name         String
  type         WorkspaceType // reuses the enum already defined for DefaultAccountTemplate.appliesTo above
  currency     String            @default("BDT")
  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  isDefault    Boolean           @default(false) // true for the auto-created personal workspace
  // Multi-workspace add-ons (additional BUSINESS-type workspaces under one
  // account, e.g. managing a family member's finances separately). phone/
  // email are just contact info entered on the New Workspace form -- not
  // used for auth. pinHash (bcrypt, like User.passwordHash) is an OPTIONAL
  // quick-lock checked before switching INTO this workspace (set at
  // creation or via Edit Workspace) -- null means no lock configured.
  // trialEndsAt is cosmetic-only for now (no enforcement): a fixed 14-day
  // trial stamped when a non-default workspace is created, shown as a
  // "Trial" badge in the UI.
  phone        String?
  email        String?
  pinHash      String?
  trialEndsAt  DateTime?
  // Overall monthly spending target shown on the Budget Planning page as
  // "Total budget" -- separate from the sum of BudgetCategory.monthlyLimit
  // ("Allocated"), which a user may intentionally under- or over-allocate
  // against. Not month-specific: one standing target, edited via "Manage
  // Budget"; only the computed "spent" figure varies by the viewed month.
  monthlyBudgetTarget Decimal?   @db.Decimal(14, 2)
  // Soft-delete only -- a workspace may hold financial data in later prompts,
  // so it's never hard-deleted. null = active. Every list/lookup query must
  // filter deletedAt: null.
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      BusinessMember[]
  accounts     Account[]
  transactions Transaction[]
  contacts     Contact[]
  budgetCategories BudgetCategory[]
  incomeGoals  IncomeGoal[]
  savingsGoals SavingsGoal[]
  assets       Asset[]
  assetCategoryOptions AssetCategoryOption[]
  groupMembers        GroupMember[]
  groupContributions  GroupContribution[]
  groupExpenses       GroupExpense[]
  groupSettlements    GroupSettlement[]
  groupExpenseCategoryOptions GroupExpenseCategoryOption[]

  @@index([ownerId])
}

model BusinessMember {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  role       MemberRole   @default(OWNER)
  invitedAt  DateTime?
  joinedAt   DateTime     @default(now())
  status     MemberStatus @default(ACTIVE)

  // @@unique below already gives an index with businessId as its leftmost
  // column (covers "all members of a business" lookups), so only userId
  // needs its own separate index here.
  @@unique([businessId, userId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  ACCOUNTANT
  STAFF
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

// =====================================================================
// Prompt 4: Chart of Accounts. Reuses AccountType/WorkspaceType (defined
// above for the admin panel's DefaultAccountTemplate) rather than
// duplicating them -- AccountsService.seedDefaultAccounts() copies rows
// from DefaultAccountTemplate into Account when a Business is created.
// =====================================================================

model Account {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id])
  parentId        String?
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  name            String
  nameBn          String?
  // User-facing reference number for a money account (e.g. a bank account
  // or mobile wallet number) -- purely informational display text, not
  // validated/used anywhere in the Transaction Engine. Optional since it
  // doesn't apply to every account (a "Cash" wallet has none).
  accountNumber   String?
  accountType     AccountType
  accountSubtype  String?
  openingBalance  Decimal            @default(0) @db.Decimal(14, 2)
  // Cached, recalculated by the Transaction Engine (Prompt 5) -- for now
  // (no transactions exist yet) it's just directly settable.
  currentBalance  Decimal            @default(0) @db.Decimal(14, 2)
  // true for accounts copied from DefaultAccountTemplate -- protects them
  // from accidental deletion (they're still archivable, just not what a
  // "delete" action would target since there's no delete endpoint here at
  // all, per Part C -- only archive).
  isSystemAccount Boolean            @default(false)
  status          AccountStatus      @default(ACTIVE)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  entries         TransactionEntry[]

  @@index([businessId, accountType])
  @@index([businessId, parentId])
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// =====================================================================
// Prompt 8: Contacts -- the people/businesses a user transacts with.
// Foundation for Prompt 9's Receivable/Payable flows (credit sale,
// partial payment, aging), which will create Transactions with
// contactId set against Accounts Receivable/Payable.
// =====================================================================

model Contact {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  name           String
  type           ContactType
  // Business (customer/supplier trade relationships, shown in Dena-Pawna)
  // vs Loan (bank/person lending relationships, shown in Loan Management).
  // Purely a categorization/filtering tag -- both categories reuse the
  // exact same type/openingBalance/Receivable-Payable engine underneath,
  // per this app's "don't build a parallel system" principle (Prompt 9).
  category       ContactCategory @default(BUSINESS)
  phone          String?
  email          String?
  address        String?
  photoUrl       String?
  // Sign convention (relied on by Prompt 9's balance calculations and by
  // the frontend's color-coding): positive = the business is OWED money by
  // this contact (money coming IN eventually); negative = the business
  // OWES this contact money (money going OUT eventually). For a CUSTOMER
  // this is normally >= 0 ("they owe us"); for a SUPPLIER it's normally
  // <= 0 ("we owe them"). The UI frames the input field in plain language
  // per contact type rather than exposing this sign directly to the user.
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  status         ContactStatus   @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]

  @@index([businessId, type])
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
  RELATIVE
  OTHER
}

enum ContactCategory {
  BUSINESS
  LOAN
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

// =====================================================================
// Prompt 5: Transaction Engine -- header (Transaction) + line-items
// (TransactionEntry) double-entry pattern. Every future money-moving
// feature (Income/Expense in Prompt 6, Transfer in Prompt 7, Receivable/
// Payable in Prompt 10, ...) is built by calling TransactionsService, not
// by writing rows here directly.
// =====================================================================

model Transaction {
  id                     String             @id @default(uuid())
  businessId             String
  business               Business           @relation(fields: [businessId], references: [id])
  transactionType        TransactionType
  transactionDate        DateTime           @db.Date
  referenceNo            String?
  description            String?
  // Wired to a real FK in Prompt 8 now that Contact exists -- was a plain
  // unconstrained field since Prompt 5. Nullable throughout, so this never
  // touched any existing seeded/test transaction (all had contactId: null).
  contactId              String?
  contact                Contact?           @relation(fields: [contactId], references: [id])
  attachmentUrl          String?
  status                 TransactionStatus  @default(POSTED)
  // Prevents duplicate submission from double-clicks/network retries --
  // createTransaction() returns the existing row instead of erroring when
  // this key is reused. Unique across the whole table (not per-business) --
  // client-generated keys (e.g. a UUID) make cross-business collision
  // astronomically unlikely, and createTransaction() still checks the
  // matching businessId before returning the existing row either way.
  idempotencyKey         String?            @unique
  createdBy              String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  voidedAt               DateTime?
  voidedReason           String?
  // If this transaction IS a reversal (created by voidTransaction()),
  // points back at the original it reverses. Plain field, no relation --
  // a self-relation isn't needed since nothing currently needs to traverse
  // from the original to find its reversal via a Prisma include (query by
  // reversalOfId directly on the rare occasion it's needed).
  reversalOfId           String?
  // Prompt 9: when set on a SALE/PURCHASE, the date it's due -- drives
  // aging/overdue. When set on a PAYMENT, which specific outstanding
  // SALE/PURCHASE this payment targets -- a payment with this left unset
  // is a general payment, allocated FIFO across the contact's oldest
  // outstanding transactions at READ time (see
  // ReceivablesPayablesService.computeDirection()), never by mutating
  // transaction/entry rows. Plain field, no relation -- same precedent as
  // reversalOfId above (queried directly, in-memory here, when needed).
  dueDate                DateTime?          @db.Date
  appliedToTransactionId String?
  entries                TransactionEntry[]

  @@index([businessId, transactionDate])
  @@index([businessId, status])
  @@index([contactId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  JOURNAL
  SALE
  PURCHASE
  PAYMENT
}

enum TransactionStatus {
  POSTED
  VOIDED
}

model TransactionEntry {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  entryType     EntryType
  amount        Decimal     @db.Decimal(14, 2)
  // No relation yet -- Category doesn't exist until a later prompt.
  categoryId    String?
  note          String?

  @@index([accountId, transactionId])
  @@index([transactionId])
}

enum EntryType {
  DEBIT
  CREDIT
}

// =====================================================================
// Budget Planning (type: EXPENSE) and Income Category (type: INCOME) --
// same underlying shape (name + icon + color + monthly limit) shown on two
// different pages. "spent" against a category is never stored, it's
// computed on read by summing that category's own type of transaction
// (EXPENSE or INCOME) whose TransactionEntry.categoryId matches this
// category's name for the requested month (same plain-string convention
// quick-entries.service.ts already uses for categoryId; see its comment on
// TransactionEntry.categoryId above). Categories are NOT month-specific --
// one standing set of categories/limits per type, reused across months.
// =====================================================================

model BudgetCategory {
  id         String             @id @default(uuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id])
  type       BudgetCategoryType @default(EXPENSE)
  name       String
  // Nullable -- a category saved without ever picking one from the grid
  // (e.g. after searching for something with no match) has no icon at all,
  // rendered as a plain colored circle rather than a default glyph.
  icon       String?
  color      String
  // Required for EXPENSE (each category has its own spending limit,
  // enforced in BudgetsService.createCategory, not here) -- null for
  // INCOME, which has no per-category goal at all -- see IncomeGoal below
  // for the real (month-specific, table-based) income goal concept.
  monthlyLimit Decimal?         @db.Decimal(14, 2)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([businessId, type, name])
  @@index([businessId])
}

enum BudgetCategoryType {
  EXPENSE
  INCOME
}

// Monthly Income Goal (its own page, /income-goal): a HISTORY of goals, one
// row per month/year, each with an optional note -- not a single standing
// value like Business.monthlyBudgetTarget. "earned" for a row is computed
// on read: the sum of every POSTED INCOME transaction's categorized entry
// (categoryId != null -- the one side of the double-entry pair that
// carries it, see quick-entries.service.ts's createIncome) for this
// business within that row's month/year, regardless of which Income
// Category it was logged against.
model IncomeGoal {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  month      Int // 1-12
  year       Int
  amount     Decimal  @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, year, month])
  @@index([businessId])
}

// =====================================================================
// Savings Goals: a named target (e.g. "Emergency Fund") funded by real
// contributions from a money account. All contributed cash pools into ONE
// system Account per business ("Savings", accountSubtype "savings" --
// deliberately NOT in MONEY_ACCOUNT_SUBTYPES so it stays out of the regular
// Wallet list/pickers, only reachable via the dedicated Savings Wallet
// page), auto-created on first contribution -- see
// SavingsGoalsService.getOrCreateSavingsAccount(). Each SavingsGoal's own
// currentAmount is never cached; it's computed on read as the signed sum of
// its SavingsGoalEntry rows (CONTRIBUTION/TRANSFER_IN positive,
// TRANSFER_OUT/WITHDRAWAL negative) -- same "compute on read" philosophy as
// Contact.currentBalance, appropriate at this feature's realistic per-goal
// entry volume.
// =====================================================================

model SavingsGoal {
  id             String                  @id @default(uuid())
  businessId     String
  business       Business                @relation(fields: [businessId], references: [id])
  name           String
  targetAmount   Decimal                 @db.Decimal(14, 2)
  targetDate     DateTime
  // Manually entered (not derived from targetDate - createdAt) -- drives the
  // "suggested monthly contribution" (targetAmount / durationMonths) shown
  // alongside the goal, same as the reference layout's "Monthly Savings"
  // card.
  durationMonths Int
  reminderDate   DateTime?
  // Only a stored preference for now -- no email/SMS is actually sent yet
  // (this app has no email provider or Bangladeshi SMS gateway configured).
  // Wiring up real delivery is a separate, later integration.
  reminderChannel SavingsReminderChannel?
  description    String?
  status         SavingsGoalStatus       @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  entries        SavingsGoalEntry[]

  @@index([businessId])
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  // Set automatically by SavingsGoalsService.withdraw() once its full saved
  // amount has been withdrawn and spent (see SavingsEntryType.WITHDRAWAL) --
  // never set directly through UpdateSavingsGoalStatusDto's manual pause/
  // resume/complete flow.
  WITHDRAWN
}

enum SavingsReminderChannel {
  EMAIL
  PHONE
}

enum SavingsEntryType {
  // Real money moved in from a wallet/bank/mfs account -- backed by a real
  // double-entry Transaction (transactionId set, moneyAccountId set).
  CONTRIBUTION
  // Internal reallocation between two goals (Savings Transfer) -- no real
  // Transaction, since the cash never leaves the pooled Savings account.
  // Always created in a TRANSFER_OUT/TRANSFER_IN pair (relatedGoalId points
  // at the other side).
  TRANSFER_OUT
  TRANSFER_IN
  // Real money moved OUT of a Savings Wallet and recorded as a real Expense
  // -- backed by a real double-entry Transaction (transactionId set,
  // savingsAccountId set to which wallet it left from), same as
  // CONTRIBUTION but reversed. Always withdraws a goal's ENTIRE current
  // saved amount at once (no partial withdrawal yet) -- see
  // SavingsGoalsService.withdraw(), which also flips the goal's status to
  // WITHDRAWN.
  WITHDRAWAL
}

// moneyAccountId/relatedGoalId/transactionId are deliberately plain string
// columns, not Prisma relations -- same "no FK for a lightweight cross-
// reference" convention as TransactionEntry.categoryId. Callers that need
// the referenced row look it up explicitly.
model SavingsGoalEntry {
  id             String           @id @default(uuid())
  savingsGoalId  String
  savingsGoal    SavingsGoal      @relation(fields: [savingsGoalId], references: [id])
  businessId     String
  type           SavingsEntryType
  amount         Decimal          @db.Decimal(14, 2)
  date           DateTime
  moneyAccountId String?
  // Only set for CONTRIBUTION -- which Savings Wallet (Account,
  // accountSubtype "savings") the money actually landed in. Multiple
  // Savings Wallets can exist per business (e.g. "Islami Bank DPS", "City
  // Bank FDR"), managed like regular money accounts (see
  // AccountsService.listSavingsWallets()'s comment) -- this is what tells
  // a contribution apart from any other, not just moneyAccountId (the
  // source).
  savingsAccountId String?
  relatedGoalId  String?
  transactionId  String?
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([savingsGoalId])
  @@index([businessId])
}

// =====================================================================
// "Assets Management" menu -- a personal asset registry (car, land/plot,
// jewellery, etc.) the user buys with real money from an existing Account
// (General money account or Savings Wallet) and can later sell or revalue.
// Same "lightweight ledger over a real Account" architecture as SavingsGoal
// (see savings-goals.service.ts's header comment) -- purchase/sell are REAL
// double-entry Transactions against a hidden pooled "Fixed Assets (Internal)"
// system Account (see AssetsService.requireOrCreateFixedAssetsAccount());
// value updates are plain data (AssetValueHistory), NOT transactions, since
// a market revaluation isn't a real cash movement the user asked to model
// as one (see AssetsService.updateValue()'s comment).
// =====================================================================

model Asset {
  id                    String              @id @default(uuid())
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id])
  name                  String
  category              String              @default("Other")
  purchaseDate          DateTime
  purchasePrice         Decimal             @db.Decimal(14, 2)
  // Cached latest value -- kept in sync by updateValue() (mirrors
  // Account.currentBalance's own "cached, recalculated" convention).
  currentValue          Decimal             @db.Decimal(14, 2)
  // Loose string FK (no @relation), same convention as
  // SavingsGoalEntry.moneyAccountId/savingsAccountId -- Account rows aren't
  // otherwise aware of Assets. Both null for an asset added via "Current
  // Asset list"'s simple Add Assets flow (Date/Asset Name/Category/Value/
  // Notes only, no Account field, no real money movement) -- see
  // AssetsService.purchase()'s comment for the branch that skips creating a
  // Transaction entirely when purchaseAccountId is omitted.
  purchaseAccountId     String?
  purchaseTransactionId String?             @unique
  status                AssetStatus         @default(ACTIVE)
  soldAt                DateTime?
  soldPrice             Decimal?            @db.Decimal(14, 2)
  soldAccountId         String?
  soldTransactionId     String?             @unique
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  valueHistory          AssetValueHistory[]

  @@index([businessId])
}

// One row per value update (including the initial purchase price as the
// first row) -- lets the Update Value modal show a simple history list.
model AssetValueHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  value      Decimal  @db.Decimal(14, 2)
  recordedAt DateTime @default(now())
  note       String?

  @@index([assetId])
}

// A per-business, user-manageable list of Asset categories -- replaces the
// old fixed AssetCategory enum. Asset.category is now a plain string (the
// category's name), same loose-reference convention as
// TransactionEntry.categoryId/BudgetCategory (see that model's own
// comment) -- deleting a category here does NOT touch existing Asset rows
// that reference its name, exactly like deleting a BudgetCategory doesn't
// touch old TransactionEntry rows.
model AssetCategoryOption {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  icon         String?
  color        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, name])
}

enum AssetStatus {
  ACTIVE
  SOLD
}

// =====================================================================
// "Referral Program" menu -- every user gets their own shareable
// referralCode (see User.referralCode); a new signup that includes someone
// else's code in RegisterDto creates one Referral row here linking the two.
// =====================================================================

// Tracks one referral relationship: referrer invited referredUser, who
// registered using referrer's referralCode. rewardAmount is a SNAPSHOT of
// the admin-configured reward at the moment this referral was created
// (SettingsService's referralRewardAmount) -- a later admin change to the
// reward amount never retroactively changes an already-created Referral's
// own amount, same "snapshot at creation time" reasoning as
// AssetsService.purchase() storing purchasePrice rather than a live lookup.
// PENDING -> CONFIRMED once referredUser has been registered 30+ days
// (self-healing on every read, same pattern as
// SavingsGoalsService.maybeMarkCompleted()) -> WITHDRAWN once the user
// cashes out their available balance (see ReferralsService.withdraw()).
model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId String         @unique
  referredUser   User           @relation("Referred", fields: [referredUserId], references: [id])
  rewardAmount   Decimal        @db.Decimal(14, 2)
  status         ReferralStatus @default(PENDING)
  confirmedAt    DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([referrerId])
}

enum ReferralStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
}

// =====================================================================
// "Group Expense" (মেস/যৌথ হিসাব) -- a GROUP-type workspace for a mess or
// joint family splitting shared costs. Deliberately NOT built on the
// Account/Transaction double-entry engine: this is a much simpler "pool in
// (contributions), pool out (expenses), split the remainder equally"
// ledger, not real bookkeeping -- forcing it through Account/Transaction,
// or through Contact's debt-sign-convention (built for customer/supplier
// trade), would distort both. Single-owner-entry model: GroupMember is a
// plain name/phone record, not a User -- participants never log into the
// app themselves, only the workspace owner (the sole BusinessMember on a
// GROUP business) records contributions/expenses on their behalf.
// =====================================================================

model GroupMember {
  id            String                  @id @default(uuid())
  businessId    String
  business      Business                @relation(fields: [businessId], references: [id])
  name          String
  phone         String?
  photoUrl      String?
  status        GroupMemberStatus       @default(ACTIVE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  contributions GroupContribution[]
  // Purely informational reverse relation for GroupExpense.paidByMemberId
  // (who physically went to the market) -- never affects settlement math.
  expensesPaid  GroupExpense[]
  settlements   GroupSettlementMember[]

  @@index([businessId, status])
}

enum GroupMemberStatus {
  ACTIVE
  ARCHIVED
}

model GroupContribution {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id])
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id])
  amount        Decimal     @db.Decimal(14, 2)
  date          DateTime    @db.Date
  note          String?
  createdAt     DateTime    @default(now())

  @@index([businessId, date])
  @@index([groupMemberId])
}

model GroupExpense {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  date           DateTime     @db.Date
  // Loose string, NOT a categoryId FK to GroupExpenseCategoryOption -- same
  // "picker list is decoupled from what's stored" convention as
  // Asset.category/AssetCategoryOption (see that model's own comment):
  // deleting a category option must never break/cascade-delete existing
  // expenses, it should just stop being offered for NEW ones.
  category       String       @default("Other")
  description    String?
  paidByMemberId String?
  paidByMember   GroupMember? @relation(fields: [paidByMemberId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([businessId, date])
}

// The editable picker list behind GroupExpense.category (see that field's
// comment on why it's a loose string, not a real FK to this table) -- same
// shape and same lazy-default-seeding pattern as AssetCategoryOption
// (AssetsService.listCategories()): the first four (Grocery/Rent/Utility/
// Other) are seeded once per business the first time its category list is
// ever requested, editable/deletable after that like any other row.
model GroupExpenseCategoryOption {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  icon         String?
  color        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, name])
}

// A "closed" snapshot of one period's settlement (see
// GroupExpensesService.closeSettlement()) -- once closed, later back-dated
// contributions/expenses falling inside that period never change these
// stored numbers, only a new, still-open period's live computation.
model GroupSettlement {
  id             String                  @id @default(uuid())
  businessId     String
  business       Business                @relation(fields: [businessId], references: [id])
  periodStart    DateTime                @db.Date
  periodEnd      DateTime                @db.Date
  totalExpense   Decimal                 @db.Decimal(14, 2)
  memberCount    Int
  // The even base share (totalExpense / memberCount, rounded) -- the actual
  // per-member share used for that member's balance is on
  // GroupSettlementMember.share, since one member absorbs the rounding
  // remainder so shares always sum exactly to totalExpense.
  perMemberShare Decimal                 @db.Decimal(14, 2)
  closedBy       String
  closedAt       DateTime                @default(now())
  members        GroupSettlementMember[]

  @@index([businessId, periodStart])
}

model GroupSettlementMember {
  id            String          @id @default(uuid())
  settlementId  String
  settlement    GroupSettlement @relation(fields: [settlementId], references: [id])
  groupMemberId String
  groupMember   GroupMember     @relation(fields: [groupMemberId], references: [id])
  contributed   Decimal         @db.Decimal(14, 2)
  share         Decimal         @db.Decimal(14, 2)
  // contributed - share: positive = this member should get money back,
  // negative = this member still owes the pool.
  balance       Decimal         @db.Decimal(14, 2)

  @@index([settlementId])
}
