generator client {
  provider = "prisma-client-js"
}

// Prisma 7: no `url` here -- the connection string lives in prisma.config.ts
// (for the CLI/migrations) and is passed explicitly as a driver adapter to
// the PrismaClient constructor at runtime (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// --- Admin domain. Admin accounts are User rows with an admin Role (see the
// User model and src/common/roles.ts); there is no separate admin table. ---

model AuditLog {
  id          String   @id @default(uuid())
  // The admin who acted -- a User whose role is one of the admin roles.
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  action      String // e.g. "ADMIN_LOGIN", "USER_SUSPENDED", "PLAN_UPDATED"
  entityType  String // e.g. "AdminUser", "PlatformUser", "SubscriptionPlan"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

// Settings › Help & support's video guides, managed in Admin › Settings:
// a YouTube video each, shown to users in this order once `shown`.
model HelpVideo {
  id        String   @id @default(uuid())
  titleEn   String
  titleBn   String?
  // GETTING_STARTED, INCOME_EXPENSE, SAVINGS, LOANS, GROUP_EXPENSE,
  // SECURITY or OTHER (help-rules.ts).
  category  String
  minutes   Int
  youtubeId String
  shown     Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// --- Prompt 2: User Management (admin's view of the SaaS's platform users,
// not the end-user app's own data model). When the real end-user app schema
// is built later (separate 20-prompt plan), this model will either be merged
// into it or referenced from it. `plan` already points at the real
// SubscriptionPlan model (added in Prompt 3) rather than a placeholder stub. ---

model PlatformUser {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  phone           String?
  status          PlatformUserStatus @default(ACTIVE)
  planId          String?
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id])
  workspaceCount  Int                @default(1)
  signupSource    String? // e.g. "web", "referral"
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // No separate @@index([email]) -- @unique above already covers it.
  @@index([status])
  @@index([createdAt])
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

// --- Prompt 3: Subscriptions (plans, coupons, and plan-change history). ---

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String // e.g. "Free", "Monthly Pro", "Yearly Pro", "Business"
  slug          String             @unique // e.g. "free", "monthly-pro"
  billingCycle  BillingCycle
  price         Decimal            @db.Decimal(10, 2)
  currency      String             @default("BDT")
  trialDays     Int                @default(0)
  isActive      Boolean            @default(true)
  featureLimits Json // e.g. { "maxWorkspaces": 1, "maxBusinessWorkspaces": 0, "maxTransactionsPerMonth": 100, "advancedReports": false, "pdfExport": false, "multiUser": false }
  displayOrder  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         PlatformUser[]
  couponUsages  CouponRedemption[]
  payments      Payment[]
  businesses    Business[] // end-user app (Prompt 1): workspaces on this plan
  subscriptions UserSubscription[]
}

enum BillingCycle {
  FREE
  MONTHLY
  YEARLY
}

model Coupon {
  id              String             @id @default(uuid())
  code            String             @unique
  discountType    DiscountType
  discountValue   Decimal            @db.Decimal(10, 2)
  maxRedemptions  Int? // null = unlimited
  timesRedeemed   Int                @default(0)
  validFrom       DateTime
  validUntil      DateTime
  applicablePlans String[] // array of SubscriptionPlan.id, empty = applies to all
  isActive        Boolean            @default(true)
  // A person may use it once (checked against CouponRedemption.userId).
  oncePerPerson   Boolean            @default(false)
  createdAt       DateTime           @default(now())
  redemptions     CouponRedemption[]
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CouponRedemption {
  id             String           @id @default(uuid())
  couponId       String
  coupon         Coupon           @relation(fields: [couponId], references: [id])
  // Legacy sandbox rows only; a customer's redemption sets userId instead.
  platformUserId String?
  // The customer (User.id) who used it -- a loose reference, like the rest.
  userId         String?
  // The payment it took money off: one redemption per payment.
  paymentId      String?          @unique
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  redeemedAt     DateTime         @default(now())

  @@index([couponId, userId])
}

model PlanChangeLog {
  id             String   @id @default(uuid())
  // Legacy sandbox rows only; a customer's change sets userId instead.
  platformUserId String?
  userId         String?
  fromPlanId     String?
  toPlanId       String
  changedBy      String // AdminUser id, or "SYSTEM" if automated
  reason         String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// A customer's plan: one row per customer, the source of truth for "my
// plan" (src/billing/subscriptions.service.ts). Their workspaces'
// Business.planId stays a mirror of planId, written by
// SubscriptionsService.applyPlan(), so everything that reads a workspace's
// plan (MRR, feature flags, announcements, owners, search, campaigns)
// keeps working unchanged.
model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  // When the paid period ends. Null on the free plan, and on a paid plan an
  // admin set by hand: that never expires until an admin sets an end.
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  // The list price paid for the running period: a new plan price starts at
  // each person's next renewal.
  lockedPrice        Decimal?           @db.Decimal(10, 2)
  // One free trial per person.
  trialUsedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  // The period ended without a renewal; the plan stays for the grace days.
  PAST_DUE
  // Ended by the customer's cancel or a full refund (now on the free plan).
  CANCELLED
  // The period or the trial ran out (now on the free plan).
  EXPIRED
}

enum PaymentPurpose {
  NEW
  RENEWAL
  UPGRADE
}

// --- Prompt 4: Payments (payments, invoices, refunds). ---

model Payment {
  id                 String              @id @default(uuid())
  // Legacy sandbox payments (POST /admin/dev/simulate-payment) only; a
  // customer's payment sets userId instead.
  platformUserId     String?
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose            PaymentPurpose      @default(NEW)
  planId             String
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id])
  amount             Decimal             @db.Decimal(10, 2)
  currency           String              @default("BDT")
  discountApplied    Decimal?            @db.Decimal(10, 2)
  couponId           String?
  gateway            PaymentGateway
  gatewayReferenceId String? // transaction id from bKash/SSLCommerz/etc, nullable until real integration
  status             PaymentStatus
  failureReason      String?
  paidAt             DateTime?
  // The plan's price at checkout, before any discount.
  listPrice          Decimal?            @db.Decimal(10, 2)
  // The friend's first-payment discount, when it beat the coupon.
  referralDiscount   Decimal?            @db.Decimal(10, 2)
  // The paid period this payment bought (set when it is marked paid).
  periodStart        DateTime?
  periodEnd          DateTime?
  // The number the money came from, typed in at Mark paid.
  payerAccount       String?
  // An unpaid checkout lapses at this time. Null once the customer sent
  // the payment's details: money already sent waits for an admin.
  expiresAt          DateTime?
  // When the customer sent the number they paid from and the TrxID
  // (payerAccount, gatewayReferenceId) for an admin to check.
  submittedAt        DateTime?
  // The customer's screenshot of the payment, when they added one.
  proof              PaymentProof?
  // The admin who marked it paid.
  markedPaidBy       String?
  createdAt          DateTime            @default(now())
  invoice            Invoice?
  refund             Refund?
  // The referral this payment earned a commission for (the friend's first).
  referral           Referral?
  // The referrer's share of this payment (any payment, renewals too).
  commission         ReferralCommission?

  @@index([platformUserId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  CARD
  MANUAL
  ROCKET
  BANK
}

// A customer's screenshot of the money they sent (Checkout), for the
// admin who checks it. Raster images only, kept in the database like a
// support screenshot (TicketAttachment).
model PaymentProof {
  id        String   @id @default(uuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Invoice {
  id            String    @id @default(uuid())
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  invoiceNumber String    @unique // e.g. INV-2026-000123, auto-generated sequential
  issuedTo      String // snapshot of user name/email at time of invoice
  issuedPhone   String? // the billing phone printed under it, when there is one
  lineItems     Json // [{ description, amount }]
  totalAmount   Decimal   @db.Decimal(10, 2)
  pdfUrl        String? // populated later when PDF generation is added
  // When the invoice was last emailed to the customer (mark-paid sends it,
  // and an admin can send it again).
  emailedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  processedBy String // AdminUser id
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

// --- Prompt 5: Content Management (default chart-of-accounts/category
// templates seeded into new workspaces, i18n strings, announcements, legal
// docs). ---

model DefaultAccountTemplate {
  id             String                   @id @default(uuid())
  name           String // e.g. "Cash", "Bank", "Sales Income", "Rent Expense"
  nameBn         String // Bangla translation
  accountType    AccountType
  accountSubtype String? // e.g. "cash", "bank", "mfs", "receivable", "payable"
  parentId       String?
  parent         DefaultAccountTemplate?  @relation("ParentChild", fields: [parentId], references: [id])
  children       DefaultAccountTemplate[] @relation("ParentChild")
  appliesTo      WorkspaceType[] // which workspace types get this by default: PERSONAL, BUSINESS
  displayOrder   Int                      @default(0)
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  categories     DefaultCategory[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
  // Mess/joint-family "Group Expense" workspace -- see the GroupMember/
  // GroupContribution/GroupExpense/GroupSettlement models near the end of
  // this file for why it's a separate, much simpler ledger rather than
  // reusing Account/Transaction.
  GROUP
}

model DefaultCategory {
  id                      String                  @id @default(uuid())
  name                    String
  nameBn                  String
  type                    CategoryDirection // INCOME or EXPENSE
  icon                    String? // icon identifier string, e.g. "utensils", "car"
  linkedAccountTemplateId String?
  linkedAccountTemplate   DefaultAccountTemplate? @relation(fields: [linkedAccountTemplateId], references: [id])
  isActive                Boolean                 @default(true)
  displayOrder            Int                     @default(0)
}

enum CategoryDirection {
  INCOME
  EXPENSE
}

model TranslationString {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "dashboard.total_income"
  en        String
  bn        String
  context   String? // e.g. "dashboard", "auth", "reports" -- for grouping in the admin UI
  updatedAt DateTime @updatedAt
  updatedBy String? // AdminUser id
}

model Announcement {
  id         String           @id @default(uuid())
  title      String
  titleBn    String?
  body       String
  bodyBn     String?
  type       AnnouncementType
  targetPlan String? // SubscriptionPlan.id, null = all users
  startAt    DateTime
  endAt      DateTime?
  isActive   Boolean          @default(true)
  // Where the banner's "Try it" goes: a page of the app ("/habit-tracker")
  // or an https address. Null = no link.
  linkUrl    String?
  createdBy  String // AdminUser id
  createdAt  DateTime         @default(now())
}

enum AnnouncementType {
  INFO
  WARNING
  PROMOTION
  MAINTENANCE
}

model LegalDocument {
  id        String       @id @default(uuid())
  type      LegalDocType @unique
  contentEn String       @db.Text
  contentBn String?      @db.Text
  version   Int          @default(1)
  updatedAt DateTime     @updatedAt
  updatedBy String?
}

enum LegalDocType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  REFUND_POLICY
  FAQ
}

// Every saved version of a legal page: drafts being written and each one
// published. Publishing copies the version onto LegalDocument (what the app
// reads) and keeps this row as history.
model LegalDocumentVersion {
  id          String                @id @default(uuid())
  type        LegalDocType
  version     Int
  contentEn   String                @db.Text
  contentBn   String?               @db.Text
  status      LegalDocVersionStatus @default(DRAFT)
  createdBy   String?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([type, version])
  @@index([type, status])
}

enum LegalDocVersionStatus {
  DRAFT
  PUBLISHED
}

// --- Prompt 6: Support (tickets, ticket messages, feature requests + votes). ---

model SupportTicket {
  id                String          @id @default(uuid())
  // Its short number for people ("ticket #482"), counted up from 1.
  number            Int             @unique @default(autoincrement())
  platformUserId    String
  subject           String
  category          TicketCategory
  priority          TicketPriority  @default(MEDIUM)
  status            TicketStatus    @default(OPEN)
  assignedToAdminId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resolvedAt        DateTime?
  // Sent by the customer from Settings › Help (not a ticket an admin opened
  // for them from a call): the queue tags it "Help page".
  fromHelpPage      Boolean         @default(false)
  // When an admin first opened it; null is "New" in the queue.
  firstSeenAt       DateTime?
  messages          TicketMessage[]

  @@index([status, priority])
  @@index([platformUserId])
}

enum TicketCategory {
  BILLING
  TECHNICAL
  ACCOUNT
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

model TicketMessage {
  id            String            @id @default(uuid())
  ticketId      String
  ticket        SupportTicket     @relation(fields: [ticketId], references: [id])
  senderType    SenderType
  senderId      String // AdminUser id or PlatformUser id depending on senderType
  message       String            @db.Text
  attachmentUrl String?
  // An admin-only note on the ticket: never shown in api/support/*, and no
  // bell or email goes out for it.
  isInternal    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  attachment    TicketAttachment?

  @@index([ticketId, createdAt])
}

// A screenshot a customer attached to a message from Settings > Help. Kept
// here rather than on the image host: it may show their money, so only the
// support team and the customer can open it.
model TicketAttachment {
  id        String        @id @default(uuid())
  messageId String        @unique
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime      @default(now())
}

enum SenderType {
  ADMIN
  USER
}

// A canned answer the support team picks from while replying (Admin >
// Tickets > Saved replies), in English and optionally Bangla.
model SavedReply {
  id        String   @id @default(uuid())
  title     String
  bodyEn    String   @db.Text
  bodyBn    String?  @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureRequest {
  id             String               @id @default(uuid())
  platformUserId String
  title          String
  description    String               @db.Text
  status         FeatureRequestStatus @default(SUBMITTED)
  voteCount      Int                  @default(1)
  createdAt      DateTime             @default(now())
}

enum FeatureRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model FeatureRequestVote {
  id               String   @id @default(uuid())
  featureRequestId String
  platformUserId   String
  createdAt        DateTime @default(now())

  @@unique([featureRequestId, platformUserId])
}

// --- Prompt 7: Analytics (raw usage events + rolled-up daily snapshots). ---

model UsageEvent {
  id             String     @id @default(uuid())
  platformUserId String
  eventType      String // e.g. "income_added", "expense_added", "report_viewed", "budget_created", "login"
  metadata       Json? // flexible extra data, e.g. { "reportType": "profit_loss" }
  deviceType     DeviceType
  country        String? // for geographic breakdown
  city           String?
  createdAt      DateTime   @default(now())

  @@index([platformUserId, createdAt])
  @@index([eventType])
  @@index([country])
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

model DailyActiveSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  dailyActive Int
  newSignups  Int
  totalUsers  Int
  createdAt   DateTime @default(now())
}

// --- Prompt 8: Security & Audit (login attempts, suspicious activity flags). ---

model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String? // e.g. "invalid_password", "account_suspended", "rate_limited"
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SuspiciousActivityFlag {
  id             String                 @id @default(uuid())
  type           SuspiciousActivityType
  description    String
  relatedAdminId String?
  // The customer it is about (UNUSUAL_LOGIN_LOCATION), when it is one.
  relatedUserId  String?
  // Names what the flag is about (e.g. "location:<userId>:<country>"), so a
  // check that runs again on the timer adds nothing new.
  dedupeKey      String?                @unique
  relatedIp      String?
  severity       Severity               @default(MEDIUM)
  status         FlagStatus             @default(OPEN)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())

  @@index([status, severity])
}

enum SuspiciousActivityType {
  MULTIPLE_FAILED_LOGINS
  UNUSUAL_LOGIN_LOCATION
  MASS_DATA_ACCESS
  IMPERSONATION_SPIKE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FlagStatus {
  OPEN
  REVIEWING
  RESOLVED
  FALSE_POSITIVE
}

// --- Prompt 9: System/Technical Management (backups, feature flags, error
// logs, API rate-limit monitoring). Everything here is simulated/manual-
// trigger rather than wired to real infrastructure -- see the module-level
// comment in system.module.ts for what's a stand-in vs. production-ready. ---

model BackupRecord {
  id           String       @id @default(uuid())
  triggeredBy  String // AdminUser id, or "SYSTEM" for scheduled
  type         BackupType
  status       BackupStatus
  sizeMb       Float?
  fileLocation String? // placeholder path/URL, real storage wiring comes later
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@index([startedAt])
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // e.g. "new_dashboard_ui", "ai_categorization_beta"
  name           String
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0) // 0-100, for gradual rollout
  targetPlanIds  String[] // empty = all plans
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

model ErrorLog {
  id         String      @id @default(uuid())
  source     ErrorSource
  message    String
  stackTrace String?     @db.Text
  severity   Severity // reused from Prompt 8 -- same schema file
  metadata   Json?
  resolved   Boolean     @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([resolved, severity])
  @@index([source, createdAt])
}

enum ErrorSource {
  BACKEND_API
  ADMIN_FRONTEND
  BACKGROUND_JOB
}

model ApiRateLimitLog {
  id             String   @id @default(uuid())
  endpoint       String
  windowStart    DateTime
  requestCount   Int
  limitExceeded  Boolean  @default(false)
  identifierType String // "ip" or "admin" or "platform_user"
  identifier     String

  @@index([endpoint, windowStart])
  @@index([limitExceeded])
}

// --- Prompt 10: Notification Management. Sending is simulated -- no real
// email/SMS/push provider is wired up yet, see notifications.module.ts. ---

model NotificationTemplate {
  id        String              @id @default(uuid())
  key       String              @unique // e.g. "subscription_expiring", "payment_failed", "welcome"
  channel   NotificationChannel
  subjectEn String? // for email
  subjectBn String?
  bodyEn    String              @db.Text
  bodyBn    String              @db.Text
  variables String[] // e.g. ["userName", "planName", "expiryDate"] -- documents what {{placeholders}} are available
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP_PUSH
}

model NotificationLog {
  id             String                @id @default(uuid())
  // Holds the customer's User.id (the column name is legacy, as on
  // SupportTicket); no foreign key.
  platformUserId String
  // The campaign that sent it, if one did.
  campaignId     String?
  templateKey    String
  channel        NotificationChannel
  status         NotificationLogStatus
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())

  @@index([platformUserId, createdAt])
  @@index([templateKey])
  @@index([campaignId])
}

enum NotificationLogStatus {
  QUEUED
  SENT
  FAILED
}

model BulkNotificationCampaign {
  id           String              @id @default(uuid())
  title        String
  templateKey  String
  targetFilter Json // e.g. { "planId": "xxx", "status": "ACTIVE" } -- describes who it goes to
  channel      NotificationChannel
  status       CampaignStatus      @default(DRAFT)
  scheduledFor DateTime?
  sentCount    Int                 @default(0)
  failedCount  Int                 @default(0)
  createdBy    String
  // When sending finished.
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// =====================================================================
// END-USER APP (separate 20-prompt plan). Same database/schema file as
// the admin panel above -- extended here, not forked. Prompt 1: identity
// (User) + workspace (Business/BusinessMember) only. Account/Transaction/
// Contact tables come in later prompts.
// =====================================================================

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  // When the owner proved the phone is theirs with an SMS code. Cleared
  // when the number changes; codes go by SMS only to a verified phone, and
  // a verified phone can reset the password.
  phoneVerifiedAt         DateTime?
  // Uploaded via POST /api/auth/avatar (same local-disk multer pattern as
  // Contact.photoUrl -- see contact-photo-upload.ts's comment), served back
  // statically from /uploads/avatars. Null shows the initials-circle
  // fallback in the UI instead.
  avatarUrl               String?
  // Settings > Profile: the wide photo over the profile (imgbb, like the
  // avatar; null shows a gradient), and a one-line address.
  coverUrl                String?
  address                 String?
  // Settings › Profile: what the person tells about themselves. Only they
  // see these; the district sets local prices and the Zakat nisab.
  occupation              String?
  dateOfBirth             DateTime?                @db.Date
  gender                  Gender?
  district                String?
  // A second number (or the one on WhatsApp), for when the main is off.
  phone2                  String?
  phone2WhatsApp          Boolean                  @default(false)
  // Settings › Security › Recovery: a second address, proved with a code
  // sent to it, that password reset links go to as well.
  recoveryEmail           String?
  // Settings › Plans & billing › Billing details: printed on receipts, and
  // the address receipts and plan reminders go to. Null uses the account's.
  billingName             String?
  billingPhone            String?
  billingEmail            String?
  // The customer's number support asks for: "SM-" and 100000 more than it.
  customerNumber          Int                      @unique @default(autoincrement())
  // When the person turned on their shareable profile card (a public page
  // at /card/<referralCode> with their name, photos and an invite); null
  // while it is off, and then that page shows nothing.
  profileCardSharedAt     DateTime?
  // No password column: the hash lives on this user's "credential"
  // AuthAccount row, where better-auth reads it (src/auth/credential-account.ts).
  // When the password was last set (CredentialsService.set); null before
  // this was recorded, or for a Google-only account.
  passwordChangedAt       DateTime?
  // Settings > App > Reminders: which in-app reminders the bell's feed
  // gets (UserNotificationsService), and when its checks last ran -- they
  // run when the feed is read, at most every half hour.
  remindBudget            Boolean                  @default(true)
  remindLoans             Boolean                  @default(true)
  remindSavings           Boolean                  @default(false)
  remindersCheckedAt      DateTime?
  // The master switch for the Habit Tracker's timed reminders (habits,
  // challenges, to-dos, namaz, Ramadan, books, skills): bell and push alike.
  remindHabits            Boolean                  @default(true)
  // Admins only: when they last pressed "Mark all as read" on the bell;
  // its rows newer than this are unread (AdminFeedService).
  adminFeedSeenAt         DateTime?
  // Shareable short code for this user's own referral link ("Referral
  // Program" menu) -- nullable because pre-existing users only get one
  // lazily backfilled the first time they open that page (see
  // ReferralsService.getReferralInfo()); every brand-new registration sets
  // one immediately (see UserAuthService.register()). Unique so a code
  // uniquely identifies its owner when a new signup's referralCode DTO
  // field is looked up.
  referralCode            String?                  @unique
  // Referrals > Profile & payouts: the name invited friends see ("Khaled
  // invited you"); null = the first word of `name`.
  referralName            String?
  // Referrals > Profile & payouts: email me when a friend's payment earns
  // me a commission, and about my withdrawals.
  referralEmailEarned     Boolean                  @default(true)
  referralEmailPayouts    Boolean                  @default(true)
  // Settings > Password Manager's own unlock secret -- deliberately separate
  // from the account password (a leaked account password must not also unlock
  // the vault). Null until the user completes first-time vault setup (see
  // PasswordVaultService.setVaultPassword()); the vault menu shows a "Set up"
  // prompt instead of an unlock form until then.
  vaultPasswordHash       String?
  preferredLanguage       LanguagePreference       @default(EN)
  status                  UserStatus               @default(ACTIVE)
  // Which side of the product this account reaches: USER is the end-user
  // app, every other value is an admin role (see src/common/roles.ts).
  role                    Role                     @default(USER)
  emailVerifiedAt         DateTime?
  // better-auth's own flag; emailVerifiedAt above keeps the "when".
  emailVerified           Boolean                  @default(false)
  // Loose reference to the admin who created this account (Admin Users >
  // Create); null for anyone who signed up themselves.
  createdBy               String?
  lastLoginAt             DateTime?
  // Settings > Resources > Delete my account (src/account-deletion): the
  // account is locked at once (status PENDING_DELETION) and purged on
  // deletionScheduledFor, 30 days on, unless the owner signs in before
  // then, which restores it. Both null otherwise.
  deletionRequestedAt     DateTime?
  deletionScheduledFor    DateTime?
  // Settings > App > Numbers and dates. digitStyle null = follow the
  // language (Bangla digits in Bangla). The week start also drives the
  // server's weekly streaks and reading weeks.
  digitStyle              DigitStyle?
  numberGrouping          NumberGrouping           @default(LAKH)
  dateStyle               DateStyle                @default(D_MMM_YYYY)
  weekStart               WeekStart                @default(SATURDAY)
  // Settings › App preferences (v16): amounts without paisa, where the app
  // opens after sign-in, rows on a page of the long lists, tighter tables,
  // the sidebar folded at first, the year reports count from, and the Hijri
  // date beside dates. Saved to the account, so every device opens alike.
  roundAmounts            Boolean                  @default(false)
  startPage               StartPage                @default(DASHBOARD)
  rowsPerPage             Int                      @default(20)
  compactTables           Boolean                  @default(false)
  sidebarCollapsed        Boolean                  @default(false)
  fiscalYearStart         FiscalYearStart          @default(JULY)
  showHijri               Boolean                  @default(false)
  // Password Manager: how long an unlock lasts (1-30 minutes; null = the
  // server's VAULT_TOKEN_EXPIRES_IN), and the wrong unlock tries counted
  // in the current 10-minute window (vaultUnlockFailedAt = its first).
  vaultLockMinutes        Int?
  vaultUnlockFailures     Int                      @default(0)
  vaultUnlockFailedAt     DateTime?
  // Settings > Security > Alerts (sent by email once Resend is set up):
  // a new device signed in, many wrong passwords in a row (at most one
  // email an hour, failedTriesAlertedAt), and an emailed code before a
  // password reset link is honoured.
  alertNewDevice          Boolean                  @default(true)
  alertFailedTries        Boolean                  @default(true)
  askCodeBeforeReset      Boolean                  @default(false)
  failedTriesAlertedAt    DateTime?
  // Settings > App > Reminders: last month's summary by email on the 1st
  // (Dhaka), and the 'YYYY-MM' it was last sent for, so it goes once.
  monthlySummaryEmail     Boolean                  @default(false)
  // AI Insights: turned on by the person (off until then), and the
  // sections of their records it may read. Password Manager is never read.
  aiInsights              Boolean                  @default(false)
  aiReads                 AiSection[]              @default([TRANSACTIONS, BUDGET, SAVINGS, LOANS])
  // The 7 AM bell row with what needs attention (AI settings).
  aiMorning               Boolean                  @default(false)
  // Settings › Notifications: each alert's channels, quiet hours, reminder
  // days and the summary (notification-prefs.ts); null is the defaults.
  notificationPrefs       Json?
  monthlySummarySentFor   String?
  // The Dhaka day the last daily or weekly summary was sent (claimed), so
  // two servers or two ticks never send it twice.
  periodSummarySentOn     String?
  // Settings › Data & privacy: which pages they open and what breaks may be
  // counted (never amounts or names), and their name shown to members of
  // their groups (initials when off).
  shareUsage              Boolean                  @default(true)
  showNameInGroups        Boolean                  @default(true)
  // Settings › Data & privacy › Backup and restore: an automatic copy at
  // 2:00 at night (Dhaka), daily or weekly, the newest backupKeep kept.
  backupAuto              Boolean                  @default(true)
  backupEvery             BackupEvery              @default(WEEKLY)
  backupKeep              Int                      @default(5)
  // The Dhaka day the last automatic backup was claimed, so two servers or
  // two ticks never take it twice.
  autoBackupOn            String?
  // A group member's login (Group Expense › member portal): made from the
  // access link a group's owner sends. It signs in with its username (or
  // its mobile number) and opens only the groups it was added to; its email
  // is a never-delivered placeholder (src/group-access).
  username                String?                  @unique
  portalOnly              Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             BusinessMember[]
  // The group member records this account signs in as.
  groupMembers            GroupMember[]
  ownedBusinesses         Business[]               @relation("BusinessOwner")
  sessions                UserSession[]
  vaultEntries            VaultEntry[]
  habits                  Habit[]
  habitMonthTrackers      HabitMonthTracker[]
  books                   Book[]
  bookGoals               BookGoal[]
  bookShelves             BookShelf[]
  skills                  Skill[]
  skillGoals              SkillGoal[]
  todoLists               TodoList[]
  todoRepeats             TodoRepeat[]
  todoCategories          TodoCategory[]
  prayerSettings          PrayerSettings?
  qazaLogs                QazaLog[]
  notes                   Note[]
  noteCategories          NoteCategory[]
  journalEntries          JournalEntry[]
  writingSettings         WritingSettings?
  ramadanPreps            RamadanPrep[]
  // Every Referral row this user created by inviting someone else (as the
  // referrer), vs. the single Referral row recording that this user was
  // THEMSELVES referred by someone else's code at registration.
  referralsMade           Referral[]               @relation("Referrer")
  referredAs              Referral?                @relation("Referred")
  passwordResetTokens     PasswordResetToken[]
  // Admin actions this account performed (admin roles only).
  auditLogs               AuditLog[]
  authSessions            AuthSession[]
  authAccounts            AuthAccount[]
  notifications           UserNotification[]
  pushSubscriptions       PushSubscription[]
  reminders               Reminder[]
  subscription            UserSubscription?
  payments                Payment[]
  payoutMethods           PayoutMethod[]
  payoutRequests          PayoutRequest[]
  referralCommissions     ReferralCommission[]
  referralLinks           ReferralLink[]
  oneTimeCodes            OneTimeCode[]
  // Two-step sign-in (src/two-step): the authenticator app, its backup
  // codes, the computers that skip the code for 30 days, and open
  // second-step challenges.
  twoFactor               TwoFactor?
  twoFactorBackupCodes    TwoFactorBackupCode[]
  trustedDevices          TrustedDevice[]
  twoStepChallenges       TwoStepChallenge[]
  // Admins only: the invites this admin sent (src/admin-invites).
  adminInvitesSent        AdminInvite[]            @relation("AdminInvitesSent")
  // Admin notes on a customer's page (only admins read them), and the
  // notes an admin wrote.
  adminNotesAbout         AdminNote[]              @relation("AdminNoteSubject")
  adminNotesWritten       AdminNote[]              @relation("AdminNoteAuthor")
  emailVerificationTokens EmailVerificationToken[]
  dataBackups             DataBackup[]

  // No separate @@index([email]) -- @unique above already creates a unique
  // index covering lookups by email (same reasoning as PlatformUser).
  @@index([role])
  // The account purge looks for PENDING_DELETION rows whose day has come.
  @@index([status, deletionScheduledFor])
}

enum DigitStyle {
  LATIN
  BENGALI
}

enum NumberGrouping {
  // 1,23,45,678 (lakh and crore)
  LAKH
  // 12,345,678
  INTERNATIONAL
}

enum DateStyle {
  // 2 Oct 2026
  D_MMM_YYYY
  // 02/10/2026
  DD_MM_YYYY
  // 2026-10-02
  YYYY_MM_DD
}

enum WeekStart {
  SATURDAY
  SUNDAY
  MONDAY
}

// A note an admin left on a customer's page (Admin > Users > a user >
// Notes). The customer never sees these. Soft-deleted, so the audit trail
// keeps its subject.
model AdminNote {
  id            String    @id @default(uuid())
  subjectUserId String
  subject       User      @relation("AdminNoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation("AdminNoteAuthor", fields: [authorId], references: [id])
  body          String    @db.Text
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([subjectUserId, createdAt])
}

// "Verify your email" (Settings > Profile): one row per link mailed, only
// the token's SHA-256 kept, like PasswordResetToken. `email` is the address
// the link proves, so a link mailed before an email change proves nothing.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One identity table for everyone who signs in -- end users and the admin
// team alike -- so a single better-auth instance serves both.
enum Role {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
  USER
}

// --- better-auth (src/auth). It writes these three tables itself; the app
// reads them for its guards and Device Management. Prefixed Auth* so they
// never collide with the chart-of-accounts Account model. ---

// One signed-in device. The app's JWTs carry this row's id (sid), so
// deleting the row signs that device out on its next request.
model AuthSession {
  id             String   @id @default(uuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Set on a super admin's read-only "View as customer" session: the admin's
  // User id (AdminOwnersController's impersonate). Null for every real sign-in.
  impersonatedBy String?

  @@index([userId])
}

// How a user proves who they are: providerId "credential" holds the bcrypt
// password hash, "google" a linked Google account.
model AuthAccount {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived values better-auth keeps between requests (OAuth state,
// email verification links).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Settings > Security > Device Management -- one row per issued refresh
// token (see UserAuthService.signRefreshToken()'s jti), created at login/
// register and updated on every refresh call. This is what makes session
// revocation actually persist (the in-memory TokenBlacklistService alone is
// lost on restart, see its own comment) -- revokeSession() sets revokedAt,
// and refresh() rejects a refresh token whose session is revoked, on top of
// the existing in-memory check. deviceLabel/userAgent/ipAddress are
// snapshotted at login time, never updated afterward, even if lastUsedAt
// moves -- a session is still "the same device" for display purposes even
// if e.g. its IP changes on a later refresh.
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  jti         String    @unique
  deviceLabel String
  ipAddress   String
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
}

// "Forgot password" flow (UserAuthService.forgotPassword()/resetPassword()) --
// one row per issued reset link, same row-per-issuance shape as UserSession
// above rather than a nullable column pair on User, so a stale/superseded
// link's history isn't lost and multiple in-flight requests are distinguishable.
// tokenHash is a SHA-256 hex digest of the raw token mailed to the user (never
// stored raw) -- deterministic (unlike bcrypt), so it supports a direct
// unique lookup instead of comparing against every row. usedAt null = still
// redeemable (until expiresAt passes); set once on successful reset, and also
// set (without resetting the password) on every older unused token for that
// user the moment a newer one is requested, so only the latest link ever works.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  // Made after an SMS code to a verified phone proved the reset, so the
  // page asks for no second code ("Ask for a code before a password reset").
  codeProven Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// --- Two-step sign-in (src/two-step), for customers and admins alike. ---

// An account's authenticator app (TOTP, RFC 6238: SHA-1, 6 digits, 30 s).
// The secret is sealed with AES-256-GCM (common/secret-box.ts, keyed by
// TWO_FACTOR_ENCRYPTION_KEY, falling back to VAULT_ENCRYPTION_KEY).
// enabledAt null = set-up started but not confirmed with a code yet.
model TwoFactor {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String
  enabledAt        DateTime?
  // The newest 30-second step a code was accepted for: a code works once.
  lastUsedStep     BigInt?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Ten single-use codes for a lost phone, shown once. Stored as an HMAC,
// never in the clear; usedAt set on use.
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// "Don't ask again on this computer for 30 days". The browser keeps the raw
// token in an httpOnly cookie; only its SHA-256 is stored. Changing or
// resetting the password removes them all.
model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum TwoStepPurpose {
  // The password (or Google) checked out; the code is still to come.
  SIGN_IN
  // An admin who must turn two-step on before getting in.
  SETUP
}

// One pending second step: the challenge token (a JWT) names this row by
// its id (jti). Single use, five minutes (fifteen for SETUP), five tries.
model TwoStepChallenge {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    TwoStepPurpose
  attempts   Int            @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// An admin invite (Security > Admin team > Invite an admin): a one-time
// link, mailed, that works for 7 days. Only the link token's SHA-256 is
// kept. The person picks their name and password and turns on two-step
// while accepting; the TOTP secret shown on that page waits here, sealed.
model AdminInvite {
  id                      String    @id @default(uuid())
  email                   String
  name                    String?
  // An admin role only (never USER).
  role                    Role
  tokenHash               String    @unique
  invitedById             String
  invitedBy               User      @relation("AdminInvitesSent", fields: [invitedById], references: [id])
  expiresAt               DateTime
  pendingSecretCiphertext String?
  acceptedAt              DateTime?
  acceptedUserId          String?
  revokedAt               DateTime?
  lastSentAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())

  @@index([email])
}

// A personal credential vault -- "Password Manager" menu (client's own
// Facebook/bank/etc. logins, unrelated to this app's own accounting data).
// passwordCiphertext is reversible (AES-256-GCM via vault-crypto.ts), NOT a
// bcrypt hash -- the whole point is the user can view it again, unlike an
// account password. Every route touching this model requires BOTH
// UserAuthGuard (real login) and VaultAccessGuard (a short-lived vault
// token from POST /api/vault/unlock) -- see password-vault.module.ts.
model VaultEntry {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  title              String
  category           VaultEntryCategory @default(OTHER)
  websiteUrl         String?
  // The account HOLDER's real name (e.g. a bank account's registered
  // name) -- distinct from usernameOrEmail below, which is the login
  // credential itself. Both optional since not every entry has both.
  holderName         String?
  usernameOrEmail    String?
  passwordCiphertext String
  // When the password itself last changed (no other field moves it), so the
  // security checkup's "older than a year" is the password's own age.
  passwordChangedAt  DateTime           @default(now())
  notes              String?
  // Starred, for the Favorites view.
  isFavorite         Boolean            @default(false)
  // "It's fine" on the security checkup's old-password warning: hidden until
  // its password changes again.
  checkupDismissedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
}

enum VaultEntryCategory {
  SOCIAL
  BANK
  // bKash, Nagad, Rocket and the like.
  MOBILE_BANKING
  EMAIL
  SHOPPING
  WORK
  WIFI
  // e-TIN, NID and other government portals.
  GOVERNMENT
  OTHER
}

enum LanguagePreference {
  EN
  BN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  // The owner asked to delete the account: locked, restorable by signing
  // in until User.deletionScheduledFor, then purged (becomes DELETED).
  PENDING_DELETION
  DELETED
}

// Habit Tracker -- a personal, User-scoped feature (no Business/workspace
// concept at all, unlike every other feature module in this schema).
// Reached via the end-user app's TopBar "Switch" button, which swaps the
// whole Sidebar into a separate app-mode -- see user-frontend's
// Sidebar.tsx/TopBar.tsx.
model Habit {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  name          String
  // Loose string, NOT a categoryId FK -- same "picker list is decoupled from
  // what's stored" convention as GroupExpense.category (see that model's own
  // comment): the frontend only ever offers a small fixed picker list
  // (Namaz/Ramadan/Book/Course/Others) via the Habits sidebar submenu and
  // HabitFormModal, not a user-editable category CRUD like Group Expense's
  // own categories, but storing it as a plain string here keeps the door
  // open to that later without a migration.
  category      String         @default("Others")
  icon          String         @default("target")
  color         String         @default("blue")
  frequencyType HabitFrequency @default(DAILY)
  // Only meaningful when frequencyType is WEEKLY_DAYS -- 0=Sunday..6=Saturday.
  weeklyDays    Int[]          @default([])
  // Only meaningful when frequencyType is WEEKLY_COUNT -- "N times a week",
  // any day of the week counts toward it.
  weeklyCount   Int?
  // Optional quantity target for a single day's check-in (e.g. "8 glasses"),
  // paired with unit for display. Null means a plain done/not-done habit.
  targetValue   Int?
  unit          String?
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logs          HabitLog[]

  @@index([userId])
}

enum HabitFrequency {
  DAILY
  WEEKLY_DAYS
  WEEKLY_COUNT
}

// One check-in per habit per calendar day -- @@unique enforces that, so
// checking in twice on the same day is an upsert (see
// HabitsService.checkIn()), never a duplicate row. onDelete: Cascade since a
// log is meaningless once its habit is gone (habits with history are
// archived instead of hard-deleted anyway -- see HabitsService.remove()  --
// so this cascade only ever fires for a habit with zero logs).
model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  completed Boolean  @default(true)
  value     Int?
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
}

// A whole month laid out as a checkbox grid (one row/column per day, one per
// item) for a habit CATEGORY -- Namaz (a Gregorian month, the five daily
// prayers) and Ramadan (see HabitTrackersService's TRACKER_CONFIG).
// Separate from Habit/HabitLog on purpose: those model one user-defined
// habit with a done/not-done check-in per day, whereas this is a month sheet
// the user creates by picking a month + year ("Create Month") or, for
// Ramadan, just a year ("Create Ramadan").
model HabitMonthTracker {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  category    String
  // Namaz: the Gregorian month, 1-12. Ramadan: always 9 (the Hijri month
  // number, HabitTrackersService's RAMADAN_MONTH) -- `year` is then the
  // Gregorian year the user typed, so one Ramadan per typed year. (A
  // Gregorian year can rarely contain two Ramadans, e.g. 2030 -- known limit.)
  // Others ("Create Challenge") has no calendar date at all -- both are null.
  month       Int?
  year        Int?
  // Others only: the free-form challenge name the user typed (e.g. "Reading",
  // "No Sugar"). Null for Namaz/Ramadan, which have no name of their own.
  name        String?
  // Number of days on the sheet when it is NOT a Gregorian month: Ramadan
  // stores 29 or 30, Others stores whatever day-count goal the user typed
  // (chosen at creation). Null for Namaz, whose day count is the real length
  // of that Gregorian month.
  totalDays   Int?
  // Column set. Namaz snapshots its fixed five prayers at creation; Ramadan
  // and Others start empty/["Roza"] and the user adds/removes the rest by hand.
  items       String[]
  createdAt   DateTime          @default(now())
  // Ramadan only: the fasts missed on this sheet that were made up after it
  // (Ramadan › Today's "I kept one").
  fastsMadeUp Int               @default(0)
  // Namaz only: the share of the month's prayers the person means to pray
  // (1-100), or null for none.
  goalPct     Int?
  // Others only: the Dhaka date day 1 falls on (today or tomorrow, as it was
  // started; Restart moves it to today). Rows from before it was kept carry
  // the UTC date of createdAt, the day the app always counted from.
  startsOn    DateTime?         @db.Date
  // Others only: the day a challenge was ended early ("End challenge"); the
  // days after it are never reached and take no ticks.
  endedOnDay  Int?
  checks      HabitMonthCheck[]
  paraLogs    RamadanParaLog[]

  // month/year are NULL for every Others tracker, and Postgres never treats
  // two NULLs as equal, so this constraint is a no-op for Others (any number
  // of concurrent named challenges can coexist) while still enforcing "one
  // Namaz sheet per month" / "one Ramadan per year" as before.
  @@unique([userId, category, month, year])
  @@index([userId, category])
}

// Ramadan › Today's "Get ready" list for one Ramadan (year: the Gregorian
// year it begins in, as its sheet is keyed): the steps ticked off.
model RamadanPrep {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  items     String[] @default([])
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

// Ramadan: how many paras of the Quran were read on one day of the sheet. A
// day with none has no row; the Quran khatam card sums them.
model RamadanParaLog {
  id        String            @id @default(uuid())
  trackerId String
  tracker   HabitMonthTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  day       Int // 1-30
  paras     Int // 1-30
  updatedAt DateTime          @updatedAt

  @@unique([trackerId, day])
}

// One row per TICKED cell only -- an unticked cell simply has no row, so
// unchecking deletes it. Cross/missed counts are derived, never stored.
model HabitMonthCheck {
  id        String            @id @default(uuid())
  trackerId String
  tracker   HabitMonthTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  day       Int // 1-31
  item      String
  // How a Namaz prayer was prayed (a mark from before statuses reads as
  // ON_TIME). MISSED is an explicit "not prayed". Ramadan and challenge
  // ticks keep the default and never read it.
  status    PrayerStatus      @default(ON_TIME)

  @@unique([trackerId, day, item])
  @@index([trackerId])
}

enum PrayerStatus {
  JAMAAT
  ON_TIME
  QAZA
  MISSED
}

enum AsrSchool {
  HANAFI
  SHAFII
}

// One person's Namaz settings: where and how prayer, Sehri and Iftar times
// are worked out (the app computes them; nothing here is a time), how the
// Hijri date is shifted to the moon as seen locally, and the day qaza
// counting starts from.
model PrayerSettings {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  city        String    @default("Dhaka")
  latitude    Float     @default(23.8103)
  longitude   Float     @default(90.4125)
  // An adhan calculation method name ("Karachi", "MuslimWorldLeague", ...).
  method      String    @default("Karachi")
  asrSchool   AsrSchool @default(HANAFI)
  // -1, 0 or 1: the Hijri date runs a day earlier or later than calculated.
  hijriAdjust Int       @default(0)
  qazaSince   DateTime? @db.Date
  updatedAt   DateTime  @updatedAt
}

// Qaza prayers made up ("I prayed a qaza"): which prayer, how many, and when.
model QazaLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  prayer    String
  count     Int      @default(1)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Habit Tracker -> Book: a personal reading list. One row per book the user
// wants to read / is reading / has finished, tracked by pages. Kept apart from
// Habit on purpose (a book has a page count and a progress, not a daily
// check-in). `status` is settled server-side from pagesRead -- see
// BooksService.settle().
enum BookStatus {
  WANT_TO_READ
  READING
  FINISHED
}

model Book {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  title      String
  author     String     @default("")
  totalPages Int
  pagesRead  Int        @default(0)
  status     BookStatus @default(WANT_TO_READ)
  // Key into the cover-colour palette (BOOK_COLORS) -- a plain string so
  // adding a colour is a code change, not a migration.
  color      String     @default("walnut")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // Put down for now (Reading now's "Pause"): still READING with its page
  // kept, shown under Up next until it is resumed or read on.
  pausedAt   DateTime?
  // What the reader paid for it, when they remember (My books' Price).
  price      Decimal?   @db.Decimal(12, 2)
  // The shelf it stands on: a built-in key (BOOK_SHELVES) or the id of one
  // of the reader's own BookShelf rows. A key that matches neither (a shelf
  // since removed) reads as "other".
  shelf      String     @default("other")
  // The reader's summary of the whole book, and when it was last saved.
  summary    String     @default("")
  summaryAt  DateTime?
  logs       BookLog[]
  notes      BookNote[]

  @@index([userId, status])
}

// A shelf of the reader's own on My books ("Poetry"), beside the built-in
// ones. `nameKey` is the name lower-cased, so one name is one shelf.
model BookShelf {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  nameKey   String
  // Key into the cover palette (BOOK_COLORS), handed out in turn.
  color     String
  createdAt DateTime @default(now())

  @@unique([userId, nameKey])
}

// One (Asia/Dhaka) day's reading of a book: how far its current page went up
// that day. BooksService.update writes it whenever pagesRead changes, so a
// correction the same day takes the pages back off; a day that ends at 0 has
// no row. It gives the reading streak and the pages read each day.
model BookLog {
  id       String   @id @default(uuid())
  bookId   String
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // The book's owner again, so a person's reading days come from one index.
  userId   String
  date     DateTime @db.Date
  pages    Int
  // The page that day's reading began on (Reading now's "Read before, up to
  // page"), so the day can be corrected later; null on older rows.
  fromPage Int?

  @@unique([bookId, date])
  @@index([userId, date])
}

// What a note on a book is: a line the reader loved, a point they marked to
// remember, or a thought of their own.
enum BookNoteKind {
  HIGHLIGHT
  UNDERLINE
  THOUGHT
}

// A note on a page of a book: the line from the book (optional) and the
// reader's own words, on a day the reader picks.
model BookNote {
  id        String       @id @default(uuid())
  bookId    String
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page      Int?
  kind      BookNoteKind @default(THOUGHT)
  line      String       @default("")
  text      String
  date      DateTime     @db.Date
  // Words highlighted while reading the note: [{ s, e, c }], character
  // offsets into `text` and a colour key (see BooksService.cleanMarks).
  marks     Json?
  createdAt DateTime     @default(now())

  @@index([bookId, createdAt])
}

// "Finish N books this year" -- one target per user per (Asia/Dhaka) year.
model BookGoal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  year   Int
  target Int

  @@unique([userId, year])
}

// Habit Tracker -> Skills (the "Course" habit category): something the user is
// learning -- a course counted in lessons, or any skill counted in hours of
// practice. `unit` is fixed at creation; `target` and `progress` are in that
// unit (HOURS are stored as MINUTES, the UI shows hours). `status` is settled
// server-side from progress -- see SkillsService.settle().
enum SkillUnit {
  LESSONS
  HOURS
  CHAPTERS
}

enum SkillStatus {
  WANT_TO_LEARN
  LEARNING
  COMPLETED
}

model Skill {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  name           String
  // Where it is learned from ("Udemy", "YouTube", "Self") -- optional.
  source         String          @default("")
  unit           SkillUnit
  target         Int
  progress       Int             @default(0)
  // The progress the activity log last accounted for. It follows every
  // progress the user reports, but NOT a "Complete" jump (which isn't
  // activity), so undoing that jump by reporting the old progress again logs
  // nothing instead of erasing the day's real activity. See SkillsService.
  loggedProgress Int             @default(0)
  status         SkillStatus     @default(WANT_TO_LEARN)
  // Keys into the colour / icon allow-lists (SKILL_COLORS / SKILL_ICONS) --
  // plain strings so adding one is a code change, not a migration.
  color          String          @default("violet")
  icon           String          @default("sparkles")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // The v16 Skills pages. Its group (SKILL_CATEGORIES), a link to the
  // course, the reason it is learned, the day it should be done by.
  category       String          @default("life")
  link           String          @default("")
  why            String          @default("")
  targetDate     DateTime?       @db.Date
  // Put down for now: still LEARNING, shown under Up next until resumed.
  pausedAt       DateTime?
  // Ground covered before it was tracked here ("Already done"), in its unit
  // (minutes for HOURS). progress = base + every day logged, capped at the
  // target (the target itself once COMPLETED).
  base           Int             @default(0)
  // Deleted, kept a while so the delete can be undone; purged by
  // housekeeping (SkillsHousekeeping). Every read leaves these out.
  deletedAt      DateTime?
  logs           SkillLog[]
  steps          SkillStep[]
  notes          SkillNote[]
  resources      SkillResource[]

  @@index([userId, status])
}

// One step on a skill's roadmap, ticked off when done.
model SkillStep {
  id        String    @id @default(uuid())
  skillId   String
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  done      Boolean   @default(false)
  doneOn    DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@index([skillId, position])
}

// A note written while learning: a title (made from the text when left
// out), the text, and the day.
model SkillNote {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  text      String
  createdAt DateTime @default(now())

  @@index([skillId, date])
}

enum SkillResourceKind {
  COURSE
  VIDEO
  BOOK
  LINK
}

// A course, video, book or link the skill is learned from.
model SkillResource {
  id        String            @id @default(uuid())
  skillId   String
  skill     Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  kind      SkillResourceKind
  title     String
  url       String            @default("")
  createdAt DateTime          @default(now())

  @@index([skillId, createdAt])
}

// How much was learned on a calendar day (Asia/Dhaka), per skill -- drives the
// weekly chart and the streak. `progress` stays the truth for the percentage;
// this only records the activity (see SkillsService.adjustLog). userId is
// copied here so the overview can read a user's recent activity in one query.
model SkillLog {
  id      String   @id @default(uuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId  String
  date    DateTime @db.Date
  amount  Int // lessons, or minutes, in the skill's unit
  // What was learned that day (the practice entry's note).
  note    String   @default("")

  @@unique([skillId, date])
  @@index([userId, date])
}

// "Complete N skills this year" -- one target per user per (Asia/Dhaka) year.
model SkillGoal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  year   Int
  target Int

  @@unique([userId, year])
}

// Habit Tracker -> To Do List: one list per (Asia/Dhaka) calendar date the user
// picks, holding any number of check-off tasks, plus one dateless list for
// "Someday". Unlike the habit trackers, a list has no "protect ticked
// history" delete rule -- a to-do is disposable, not a record, so it can be
// deleted at any time regardless of completed tasks.
model TodoList {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  // null on the Someday list.
  date      DateTime?  @db.Date
  // The owner's id on their Someday list, null on a day's list: the unique
  // index keeps it to one Someday list per person.
  somedayOf String?    @unique
  createdAt DateTime   @default(now())
  items     TodoItem[]

  @@unique([userId, date])
  @@index([userId])
}

// A To Do List "list" (the board's Personal, Work, Home, Deen, or one the
// person adds): a name and a colour a task is filed under. The four built-in
// ones carry a key and are made the first time the lists are read; their
// names are translated by the app. Not to be confused with TodoList, a day.
model TodoCategory {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  // personal, work, home or deen on a built-in list; null on one the person added.
  key       String?
  name      String
  // A palette key (blue, violet, orange, green, pink, teal, yellow, indigo,
  // emerald, purple), drawn with the app's own tints.
  color     String
  createdAt DateTime     @default(now())
  items     TodoItem[]
  repeats   TodoRepeat[]

  @@unique([userId, key])
  @@index([userId])
}

model TodoItem {
  id           String        @id @default(uuid())
  listId       String
  list         TodoList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  text         String
  completed    Boolean       @default(false)
  priority     TodoPriority  @default(MEDIUM)
  // "HH:MM" on a 24-hour clock, Dhaka time; null = any time that day.
  dueTime      String?
  // A reminder this many minutes before dueTime (0 = at the time); null =
  // none. Only fires while dueTime is set (RemindersScheduler).
  remindBefore Int?
  // The day the task was first planned for, once it was put off to a later one.
  movedFrom    DateTime?     @db.Date
  // How many times it was put off to a later day.
  moveCount    Int           @default(0)
  // When it was ticked off; null while open.
  completedAt  DateTime?
  // The list it is filed under; null reads as the built-in Personal list.
  categoryId   String?
  category     TodoCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note         String        @default("")
  // Smaller steps, in order: [{ "text": string, "done": boolean }].
  steps        Json          @default("[]")
  // Set on a task a repeat rule added; one per rule per day.
  repeatId     String?
  repeat       TodoRepeat?   @relation(fields: [repeatId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@unique([repeatId, listId])
  @@index([listId])
  @@index([categoryId])
}

enum TodoPriority {
  HIGH
  MEDIUM
  LOW
}

enum TodoRepeatKind {
  DAILY
  WEEKLY
  MONTHLY
}

// A task that adds itself to the to-do list on its days: every day, on
// certain weekdays, or once a month. Its copies are made a week ahead, and
// only once each, so a deleted copy stays deleted.
model TodoRepeat {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  text          String
  priority      TodoPriority   @default(MEDIUM)
  dueTime       String?
  // Copied onto each copy, like dueTime.
  remindBefore  Int?
  // Copied onto each copy too; the steps start unticked on every one.
  categoryId    String?
  category      TodoCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note          String         @default("")
  steps         Json           @default("[]")
  kind          TodoRepeatKind
  // WEEKLY: 0 = Sunday ... 6 = Saturday.
  weekdays      Int[]
  // MONTHLY: the day of the month; a shorter month uses its last day.
  monthDay      Int?
  startsOn      DateTime       @db.Date
  // Copies exist for every day up to and including this one.
  filledThrough DateTime?      @db.Date
  // The last day it adds itself; null while it keeps going.
  endsOn        DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  items         TodoItem[]

  @@index([userId])
  @@index([categoryId])
}

// Habit Tracker > Write > Notes (the NotesHome board): quick notes and
// ideas, personal like the rest of the Habit Tracker (no workspace).
enum NoteKind {
  NOTE
  IDEA
}

model Note {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  kind       NoteKind      @default(NOTE)
  // Empty when the note has none: a quick note is just its text.
  title      String        @default("")
  body       String
  categoryId String?
  category   NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Lowercase, without the "#".
  tags       String[]      @default([])
  // The card's tint by name (white, yellow, green, blue, pink, purple).
  color      String        @default("white")
  pinned     Boolean       @default(false)
  archived   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, archived])
}

// The categories notes and journal entries share (Work, Family, ...).
// Deleting one keeps its notes and entries, without a category.
model NoteCategory {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  name           String
  // By name: blue, rose, amber, violet, teal, green, slate.
  color          String
  createdAt      DateTime       @default(now())
  notes          Note[]
  journalEntries JournalEntry[]

  @@index([userId])
}

// Habit Tracker > Write > Journal (the JournalHome board): one entry a day,
// a short daily journal or a free diary page.
enum JournalKind {
  DAILY
  DIARY
}

model JournalEntry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  date        DateTime      @db.Date
  kind        JournalKind   @default(DAILY)
  // 0 Great, 1 Good, 2 Okay, 3 Low, 4 Hard.
  mood        Int
  // The daily journal's three prompts; a diary page has only the body.
  wentWell    String        @default("")
  gratefulFor String        @default("")
  tomorrow    String        @default("")
  body        String        @default("")
  categoryId  String?
  category    NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // The #tags written in it, lowercase, kept for search.
  tags        String[]      @default([])
  // Shown and searched only after the diary PIN is entered on this sign-in.
  isPrivate   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, date])
}

// One person's Write settings. The row exists once the starter categories
// were added, so deleting them all never brings them back. The diary PIN
// (bcrypt) guards private journal entries; wrong PINs are counted like the
// vault's (ten in ten minutes, then a wait).
model WritingSettings {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  diaryPinHash String?
  pinFailures  Int       @default(0)
  pinFailedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Business {
  id                          String                       @id @default(uuid())
  ownerId                     String
  owner                       User                         @relation("BusinessOwner", fields: [ownerId], references: [id])
  name                        String
  type                        WorkspaceType // reuses the enum already defined for DefaultAccountTemplate.appliesTo above
  currency                    String                       @default("BDT")
  planId                      String?
  plan                        SubscriptionPlan?            @relation(fields: [planId], references: [id])
  isDefault                   Boolean                      @default(false) // true for the auto-created personal workspace
  // Multi-workspace add-ons (additional BUSINESS-type workspaces under one
  // account, e.g. managing a family member's finances separately). phone/
  // email are just contact info entered on the New Workspace form -- not
  // used for auth. pinHash (bcrypt, like User.passwordHash) is an OPTIONAL
  // quick-lock checked before switching INTO this workspace (set at
  // creation or via Edit Workspace) -- null means no lock configured.
  // trialEndsAt is cosmetic-only for now (no enforcement): a fixed 14-day
  // trial stamped when a non-default workspace is created, shown as a
  // "Trial" badge in the UI.
  phone                       String?
  email                       String?
  pinHash                     String?
  trialEndsAt                 DateTime?
  // Overall monthly spending target shown on the Budget Planning page as
  // "Total budget" -- separate from the sum of BudgetCategory.monthlyLimit
  // ("Allocated"), which a user may intentionally under- or over-allocate
  // against. Not month-specific: one standing target, edited via "Manage
  // Budget"; only the computed "spent" figure varies by the viewed month.
  monthlyBudgetTarget         Decimal?                     @db.Decimal(14, 2)
  // Soft-delete only -- a workspace may hold financial data in later prompts,
  // so it's never hard-deleted. null = active. Every list/lookup query must
  // filter deletedAt: null.
  deletedAt                   DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  members                     BusinessMember[]
  accounts                    Account[]
  transactions                Transaction[]
  contacts                    Contact[]
  budgetCategories            BudgetCategory[]
  incomeGoals                 IncomeGoal[]
  savingsGoals                SavingsGoal[]
  savingsPlans                SavingsPlan[]
  zakatProfile                ZakatProfile?
  zakatExtras                 ZakatExtra[]
  zakatPayments               ZakatPayment[]
  eventPeople                 EventPerson[]
  socialEvents                SocialEvent[]
  eventGifts                  EventGift[]
  assets                      Asset[]
  assetCategoryOptions        AssetCategoryOption[]
  investments                 Investment[]
  groupMembers                GroupMember[]
  groupContributions          GroupContribution[]
  groupCashHandovers          GroupCashHandover[]
  groupExpenses               GroupExpense[]
  groupSettlements            GroupSettlement[]
  groupExpenseCategoryOptions GroupExpenseCategoryOption[]
  groupMonthlyBudgets         GroupMonthlyBudget[]
  groupSettings               GroupSettings?
  groupActivities             GroupActivity[]
  groupMeals                  GroupMeal[]
  groupAccessLinks            GroupAccessLink[]

  @@index([ownerId])
}

model BusinessMember {
  id               String       @id @default(uuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id])
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  role             MemberRole   @default(OWNER)
  invitedAt        DateTime?
  joinedAt         DateTime     @default(now())
  status           MemberStatus @default(ACTIVE)
  // Settings › App preferences › Default account for new transactions:
  // the wallet picked first when this member adds income or an expense.
  defaultAccountId String?

  // @@unique below already gives an index with businessId as its leftmost
  // column (covers "all members of a business" lookups), so only userId
  // needs its own separate index here.
  @@unique([businessId, userId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  ACCOUNTANT
  STAFF
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

// =====================================================================
// Prompt 4: Chart of Accounts. Reuses AccountType/WorkspaceType (defined
// above for the admin panel's DefaultAccountTemplate) rather than
// duplicating them -- AccountsService.seedDefaultAccounts() copies rows
// from DefaultAccountTemplate into Account when a Business is created.
// =====================================================================

model Account {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id])
  parentId        String?
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  name            String
  nameBn          String?
  // User-facing reference number for a money account (e.g. a bank account
  // or mobile wallet number) -- purely informational display text, not
  // validated/used anywhere in the Transaction Engine. Optional since it
  // doesn't apply to every account (a "Cash" wallet has none).
  accountNumber   String?
  // A money account's card colour, one of ACCOUNT_COLORS (accounts.service);
  // null draws its type's own colour.
  color           String?
  accountType     AccountType
  accountSubtype  String?
  openingBalance  Decimal            @default(0) @db.Decimal(14, 2)
  // Cached, recalculated by the Transaction Engine (Prompt 5) -- for now
  // (no transactions exist yet) it's just directly settable.
  currentBalance  Decimal            @default(0) @db.Decimal(14, 2)
  // true for accounts copied from DefaultAccountTemplate -- protects them
  // from accidental deletion (they're still archivable, just not what a
  // "delete" action would target since there's no delete endpoint here at
  // all, per Part C -- only archive).
  isSystemAccount Boolean            @default(false)
  status          AccountStatus      @default(ACTIVE)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  entries         TransactionEntry[]
  // The savings goals that keep their money here (a savings account).
  keptGoals       SavingsGoal[]      @relation("SavingsGoalAccount")

  @@index([businessId, accountType])
  @@index([businessId, parentId])
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// =====================================================================
// Prompt 8: Contacts -- the people/businesses a user transacts with.
// Foundation for Prompt 9's Receivable/Payable flows (credit sale,
// partial payment, aging), which will create Transactions with
// contactId set against Accounts Receivable/Payable.
// =====================================================================

model Contact {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  name           String
  type           ContactType
  // Business (customer/supplier trade relationships, shown in Dena-Pawna)
  // vs Loan (bank/person lending relationships, shown in Loan Management).
  // Purely a categorization/filtering tag -- both categories reuse the
  // exact same type/openingBalance/Receivable-Payable engine underneath,
  // per this app's "don't build a parallel system" principle (Prompt 9).
  category       ContactCategory @default(BUSINESS)
  phone          String?
  email          String?
  address        String?
  photoUrl       String?
  // Sign convention (relied on by Prompt 9's balance calculations and by
  // the frontend's color-coding): positive = the business is OWED money by
  // this contact (money coming IN eventually); negative = the business
  // OWES this contact money (money going OUT eventually). For a CUSTOMER
  // this is normally >= 0 ("they owe us"); for a SUPPLIER it's normally
  // <= 0 ("we owe them"). The UI frames the input field in plain language
  // per contact type rather than exposing this sign directly to the user.
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  status         ContactStatus   @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]

  @@index([businessId, type])
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
  RELATIVE
  // A bank or an NGO (microfinance) one borrows from or lends to.
  BANK
  NGO
  OTHER
}

enum ContactCategory {
  BUSINESS
  LOAN
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

// =====================================================================
// Prompt 5: Transaction Engine -- header (Transaction) + line-items
// (TransactionEntry) double-entry pattern. Every future money-moving
// feature (Income/Expense in Prompt 6, Transfer in Prompt 7, Receivable/
// Payable in Prompt 10, ...) is built by calling TransactionsService, not
// by writing rows here directly.
// =====================================================================

model Transaction {
  id                     String             @id @default(uuid())
  businessId             String
  business               Business           @relation(fields: [businessId], references: [id])
  transactionType        TransactionType
  transactionDate        DateTime           @db.Date
  referenceNo            String?
  description            String?
  // Wired to a real FK in Prompt 8 now that Contact exists -- was a plain
  // unconstrained field since Prompt 5. Nullable throughout, so this never
  // touched any existing seeded/test transaction (all had contactId: null).
  contactId              String?
  contact                Contact?           @relation(fields: [contactId], references: [id])
  attachmentUrl          String?
  status                 TransactionStatus  @default(POSTED)
  // Prevents duplicate submission from double-clicks/network retries --
  // createTransaction() returns the existing row instead of erroring when
  // this key is reused. Unique across the whole table (not per-business) --
  // client-generated keys (e.g. a UUID) make cross-business collision
  // astronomically unlikely, and createTransaction() still checks the
  // matching businessId before returning the existing row either way.
  idempotencyKey         String?            @unique
  createdBy              String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  voidedAt               DateTime?
  voidedReason           String?
  // If this transaction IS a reversal (created by voidTransaction()),
  // points back at the original it reverses. Plain field, no relation --
  // a self-relation isn't needed since nothing currently needs to traverse
  // from the original to find its reversal via a Prisma include (query by
  // reversalOfId directly on the rare occasion it's needed).
  reversalOfId           String?
  // Set on an entry made by Edit (decision D2): the original it corrects,
  // which was voided 'Corrected' in the same request. Plain field, like
  // reversalOfId; at most one correction per original.
  correctedFromId        String?            @unique
  // Set on a charge (a bank or service fee) posted with a loan entry: the
  // entry it was paid with. Plain field, like reversalOfId; voiding or
  // correcting the entry voids its charge too.
  chargeForId            String?
  // Prompt 9: when set on a SALE/PURCHASE, the date it's due -- drives
  // aging/overdue. When set on a PAYMENT, which specific outstanding
  // SALE/PURCHASE this payment targets -- a payment with this left unset
  // is a general payment, allocated FIFO across the contact's oldest
  // outstanding transactions at READ time (see
  // ReceivablesPayablesService.computeDirection()), never by mutating
  // transaction/entry rows. Plain field, no relation -- same precedent as
  // reversalOfId above (queried directly, in-memory here, when needed).
  dueDate                DateTime?          @db.Date
  appliedToTransactionId String?
  // The file it came from (Settings › Data & privacy › Import), so imported
  // entries can be told apart and counted.
  importedFrom           String?
  entries                TransactionEntry[]

  @@index([businessId, transactionDate])
  @@index([businessId, status])
  @@index([contactId])
  @@index([chargeForId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  JOURNAL
  SALE
  PURCHASE
  PAYMENT
}

enum TransactionStatus {
  POSTED
  VOIDED
}

model TransactionEntry {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  entryType     EntryType
  amount        Decimal     @db.Decimal(14, 2)
  // No relation yet -- Category doesn't exist until a later prompt.
  categoryId    String?
  note          String?

  @@index([accountId, transactionId])
  @@index([transactionId])
}

enum EntryType {
  DEBIT
  CREDIT
}

// =====================================================================
// Budget Planning (type: EXPENSE) and Income Category (type: INCOME) --
// same underlying shape (name + icon + color + monthly limit) shown on two
// different pages. "spent" against a category is never stored, it's
// computed on read by summing that category's own type of transaction
// (EXPENSE or INCOME) whose TransactionEntry.categoryId matches this
// category's name for the requested month (same plain-string convention
// quick-entries.service.ts already uses for categoryId; see its comment on
// TransactionEntry.categoryId above). Categories are NOT month-specific --
// one standing set of categories/limits per type, reused across months.
// =====================================================================

model BudgetCategory {
  id           String             @id @default(uuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id])
  type         BudgetCategoryType @default(EXPENSE)
  name         String
  // Nullable -- a category saved without ever picking one from the grid
  // (e.g. after searching for something with no match) has no icon at all,
  // rendered as a plain colored circle rather than a default glyph.
  icon         String?
  color        String
  // Required for EXPENSE (each category has its own spending limit,
  // enforced in BudgetsService.createCategory, not here) -- null for
  // INCOME, which has no per-category goal at all -- see IncomeGoal below
  // for the real (month-specific, table-based) income goal concept.
  monthlyLimit Decimal?           @db.Decimal(14, 2)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([businessId, type, name])
  @@index([businessId])
}

enum BudgetCategoryType {
  EXPENSE
  INCOME
}

// Monthly Income Goal (its own page, /income-goal): a HISTORY of goals, one
// row per month/year, each with an optional note -- not a single standing
// value like Business.monthlyBudgetTarget. "earned" for a row is computed
// on read: the sum of every POSTED INCOME transaction's categorized entry
// (categoryId != null -- the one side of the double-entry pair that
// carries it, see quick-entries.service.ts's createIncome) for this
// business within that row's month/year, regardless of which Income
// Category it was logged against.
model IncomeGoal {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  month         Int // 1-12
  year          Int
  // The month's income target.
  amount        Decimal  @db.Decimal(14, 2)
  // The month's expense budget (Budget Planning); null for a plan made
  // before there was one.
  expenseBudget Decimal? @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, year, month])
  @@index([businessId])
}

// =====================================================================
// Savings Goals: a named target (e.g. "Emergency Fund") funded by real
// contributions from a money account. All contributed cash pools into ONE
// system Account per business ("Savings", accountSubtype "savings" --
// deliberately NOT in MONEY_ACCOUNT_SUBTYPES so it stays out of the regular
// Wallet list/pickers, only reachable via the dedicated Savings Wallet
// page), auto-created on first contribution -- see
// SavingsGoalsService.getOrCreateSavingsAccount(). Each SavingsGoal's own
// currentAmount is never cached; it's computed on read as the signed sum of
// its SavingsGoalEntry rows (CONTRIBUTION/TRANSFER_IN positive,
// TRANSFER_OUT/WITHDRAWAL negative) -- same "compute on read" philosophy as
// Contact.currentBalance, appropriate at this feature's realistic per-goal
// entry volume.
// =====================================================================

model SavingsGoal {
  id                     String                  @id @default(uuid())
  businessId             String
  business               Business                @relation(fields: [businessId], references: [id])
  name                   String
  targetAmount           Decimal                 @db.Decimal(14, 2)
  targetDate             DateTime
  // Manually entered (not derived from targetDate - createdAt) -- drives the
  // "suggested monthly contribution" (targetAmount / durationMonths) shown
  // alongside the goal, same as the reference layout's "Monthly Savings"
  // card.
  durationMonths         Int
  reminderDate           DateTime?
  // Only a stored preference for now -- no email/SMS is actually sent yet
  // (this app has no email provider or Bangladeshi SMS gateway configured).
  // Wiring up real delivery is a separate, later integration.
  reminderChannel        SavingsReminderChannel?
  description            String?
  status                 SavingsGoalStatus       @default(ACTIVE)
  // What was already saved when the goal was made (its first contribution,
  // with no source account), where its plan line starts on createdAt.
  startAmount            Decimal                 @default(0) @db.Decimal(14, 2)
  // The plan line runs from planStartAmount on planStartDate to the target
  // on targetDate. Null: from startAmount on createdAt. Catch up and Resume
  // start a fresh line from that day and what was saved then.
  planStartDate          DateTime?
  planStartAmount        Decimal?                @db.Decimal(14, 2)
  // The day the goal reached its target; kept through a full withdrawal, so
  // a withdrawn goal with one was Achieved, and one without was closed early.
  reachedAt              DateTime?
  // Catch up's "save the needed amount a month from now" sends a reminder
  // email on the 1st of each month while the goal is active.
  monthlyReminder        Boolean                 @default(false)
  // The reminderDate an email already went out for, and the month ("2026-11")
  // of the last monthly reminder, so neither is sent twice.
  reminderSentFor        DateTime?
  monthlyReminderSentFor String?
  // The savings account the goal keeps its money in ("Keep the money in"):
  // every deposit goes here. Money moved in from another goal can sit in
  // other accounts too (its holdings). Null for an older goal with no
  // deposits yet, or once its account is deleted.
  // The card colour the customer picked (one of GOAL_COLORS,
  // savings-goals/goal-colors.ts). Null: an older goal, drawn in the colour
  // its place in the list gives it.
  color                  String?
  accountId              String?
  account                Account?                @relation("SavingsGoalAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  entries                SavingsGoalEntry[]

  @@index([businessId])
  @@index([accountId])
}

// Savings Goals > Saving plans: things the customer wants to save for later.
// A plan is only a note -- no money is saved or taken -- until it is started
// as a goal (SavingsGoalsService.create() with fromPlanId removes it), and a
// goal with no money moved yet can go back to being a plan.
model SavingsPlan {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id])
  name       String
  // What kind of thing it is (the form's chips): trip, phone, umrah,
  // education, wedding or others (SAVINGS_PLAN_CATEGORIES).
  category   String              @default("others")
  // Its card colour, one of GOAL_COLORS; the goal it starts takes it.
  color      String
  amount     Decimal             @db.Decimal(14, 2)
  // When it is needed: within 3 or 6 months or 1 or 2 years from now, by
  // a date (needBy), or some day with no date.
  horizon    SavingsPlanHorizon
  needBy     DateTime?
  priority   SavingsPlanPriority @default(MEDIUM)
  note       String?
  link       String?
  // The day it was planned; kept when a deleted plan is put back.
  plannedOn  DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([businessId])
}

enum SavingsPlanHorizon {
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
  TWO_YEARS
  BY_DATE
  SOMEDAY
}

enum SavingsPlanPriority {
  HIGH
  MEDIUM
  LOW
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  // Set automatically by SavingsGoalsService.withdraw() once its full saved
  // amount has been withdrawn and spent (see SavingsEntryType.WITHDRAWAL) --
  // never set directly through UpdateSavingsGoalStatusDto's manual pause/
  // resume/complete flow.
  WITHDRAWN
}

enum SavingsReminderChannel {
  EMAIL
  PHONE
}

enum SavingsEntryType {
  // Real money moved in from a wallet/bank/mfs account -- backed by a real
  // double-entry Transaction (transactionId set, moneyAccountId set).
  CONTRIBUTION
  // Internal reallocation between two goals (Savings Transfer) -- no real
  // Transaction, since the cash stays in the same Savings Wallet. Always
  // created in a TRANSFER_OUT/TRANSFER_IN pair (relatedGoalId points at the
  // other side, savingsAccountId at the wallet whose money changes goal;
  // older pairs have none, see savings-holdings.ts).
  TRANSFER_OUT
  TRANSFER_IN
  // Real money moved OUT of a Savings Wallet -- backed by a real double-entry
  // Transaction (transactionId set, savingsAccountId set to which wallet it
  // left from). Today it goes to a main balance account (moneyAccountId),
  // any amount up to what is saved; older ones were the whole amount,
  // spent as an Expense. Taking everything out marks the goal WITHDRAWN.
  WITHDRAWAL
  // The goal moved to another savings account and took its money along:
  // real money moved from one Savings Wallet (moneyAccountId) to the goal's
  // new one (savingsAccountId), backed by a Transfer Transaction
  // (transactionId). One entry per wallet it left, sharing a groupId. The
  // goal's saved amount stays the same.
  ACCOUNT_CHANGE
  // Profit the bank paid on the goal's savings (Add profit): real money
  // into the goal's savings wallet (savingsAccountId), counted as income
  // under the category picked (category), backed by an INCOME Transaction
  // (transactionId). No account of the customer's pays it, so it is not
  // money "added" from their balance.
  PROFIT
}

// moneyAccountId/relatedGoalId/transactionId are deliberately plain string
// columns, not Prisma relations -- same "no FK for a lightweight cross-
// reference" convention as TransactionEntry.categoryId. Callers that need
// the referenced row look it up explicitly.
model SavingsGoalEntry {
  id               String           @id @default(uuid())
  savingsGoalId    String
  savingsGoal      SavingsGoal      @relation(fields: [savingsGoalId], references: [id])
  businessId       String
  type             SavingsEntryType
  amount           Decimal          @db.Decimal(14, 2)
  date             DateTime
  moneyAccountId   String?
  // Only set for CONTRIBUTION -- which Savings Wallet (Account,
  // accountSubtype "savings") the money actually landed in. Multiple
  // Savings Wallets can exist per business (e.g. "Islami Bank DPS", "City
  // Bank FDR"), managed like regular money accounts (see
  // AccountsService.listSavingsWallets()'s comment) -- this is what tells
  // a contribution apart from any other, not just moneyAccountId (the
  // source).
  savingsAccountId String?
  relatedGoalId    String?
  transactionId    String?
  // One move between goals, or one withdrawal, can take money from several
  // savings wallets: each part is its own entry (a TRANSFER_OUT/TRANSFER_IN
  // pair per wallet), and they share this id, so the move lists and undoes
  // as one.
  groupId          String?
  // PROFIT only: the income category it is counted under (a category
  // name, as TransactionEntry.categoryId holds it).
  category         String?
  notes            String?
  createdAt        DateTime         @default(now())

  @@index([savingsGoalId])
  @@index([businessId])
  @@index([groupId])
}

// =====================================================================
// "Assets Management" menu -- a personal asset registry (car, land/plot,
// jewellery, etc.) the user buys with real money from an existing Account
// (General money account or Savings Wallet) and can later sell or revalue.
// Same "lightweight ledger over a real Account" architecture as SavingsGoal
// (see savings-goals.service.ts's header comment) -- purchase/sell are REAL
// double-entry Transactions against a hidden pooled "Fixed Assets (Internal)"
// system Account (see AssetsService.requireOrCreateFixedAssetsAccount());
// value updates are plain data (AssetValueHistory), NOT transactions, since
// a market revaluation isn't a real cash movement the user asked to model
// as one (see AssetsService.updateValue()'s comment).
// =====================================================================

model Asset {
  id                    String              @id @default(uuid())
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id])
  name                  String
  category              String              @default("Other")
  purchaseDate          DateTime
  purchasePrice         Decimal             @db.Decimal(14, 2)
  // Cached latest value -- kept in sync by updateValue() (mirrors
  // Account.currentBalance's own "cached, recalculated" convention).
  currentValue          Decimal             @db.Decimal(14, 2)
  // Loose string FK (no @relation), same convention as
  // SavingsGoalEntry.moneyAccountId/savingsAccountId -- Account rows aren't
  // otherwise aware of Assets. Both null for an asset added via "Current
  // Asset list"'s simple Add Assets flow (Date/Asset Name/Category/Value/
  // Notes only, no Account field, no real money movement) -- see
  // AssetsService.purchase()'s comment for the branch that skips creating a
  // Transaction entirely when purchaseAccountId is omitted.
  purchaseAccountId     String?
  purchaseTransactionId String?             @unique
  status                AssetStatus         @default(ACTIVE)
  soldAt                DateTime?
  soldPrice             Decimal?            @db.Decimal(14, 2)
  soldAccountId         String?
  soldTransactionId     String?             @unique
  // The note written with the sale (who bought it, papers handed over).
  soldNote              String?
  notes                 String?
  // Gold or silver jewellery: its metal and weight in vori, so Zakat values
  // it at today's price per vori (null: by currentValue).
  metal                 ZakatMetal?
  weightVori            Decimal?            @db.Decimal(10, 3)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  valueHistory          AssetValueHistory[]

  @@index([businessId])
}

// One row per value update (including the initial purchase price as the
// first row) -- lets the Update Value modal show a simple history list.
model AssetValueHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  value      Decimal  @db.Decimal(14, 2)
  recordedAt DateTime @default(now())
  note       String?

  @@index([assetId])
}

// A per-business, user-manageable list of Asset categories -- replaces the
// old fixed AssetCategory enum. Asset.category is now a plain string (the
// category's name), same loose-reference convention as
// TransactionEntry.categoryId/BudgetCategory (see that model's own
// comment) -- deleting a category here does NOT touch existing Asset rows
// that reference its name, exactly like deleting a BudgetCategory doesn't
// touch old TransactionEntry rows.
model AssetCategoryOption {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  icon         String?
  color        String
  displayOrder Int      @default(0)
  // Off: left out of the Purchase and Add asset dropdowns; its assets stay.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, name])
}

// An asset deleted in the last few minutes, kept so the delete can be undone:
// the asset and its value history as they were (snapshot), and who deleted
// it. Its postings stay voided until the undo brings them back. Loose ids,
// no relations: the row outlives the asset and housekeeping removes it once
// the undo window has passed.
model AssetDeletion {
  assetId    String   @id
  businessId String
  deletedBy  String
  deletedAt  DateTime @default(now())
  snapshot   Json

  @@index([deletedAt])
}

enum AssetStatus {
  ACTIVE
  SOLD
}

// =====================================================================
// Investments: money put into a business or partnership, a sanchayapatra,
// a bank FDR, shares, a property or anything else that pays a profit.
// Capital is never typed: it is what was put in (INVEST, ADD) less what
// came back (BACK) and what was lost (LOSS), worked out from the entries.
//
// Money moves through TransactionsService like every other feature: money
// put in from a wallet leaves it into a hidden pooled "Investments
// (Internal)" system Account (subtype 'investments', outside the money
// subtypes, so no wallet list or total sees it), capital back comes out of
// it, and a profit is an INCOME posting into the wallet it came into. A
// loss moves no money and has no posting; neither has money put in
// earlier, before the app (accountId null). An entry owns its posting:
// Transactions refuses to void it, the investment pages undo it.
// =====================================================================

model Investment {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id])
  name            String
  kind            InvestmentKind       @default(OTHER)
  // The day the money was first put in (the INVEST entry's day).
  startDate       DateTime             @db.Date
  frequency       InvestmentFrequency  @default(IRREGULAR)
  // What each payout is expected to be: a fixed amount, a yearly rate on
  // the capital, or not fixed (NONE). Always NONE when frequency is
  // IRREGULAR.
  payoutMode      InvestmentPayoutMode @default(NONE)
  fixedAmount     Decimal?             @db.Decimal(14, 2)
  ratePercent     Decimal?             @db.Decimal(5, 2)
  // The first payout's day; the rest follow every `frequency` from it.
  firstDueDate    DateTime?            @db.Date
  maturityDate    DateTime?            @db.Date
  // The wallet profit is expected in (Record profit picks it first). Loose
  // string FK, like Asset.purchaseAccountId.
  profitAccountId String?
  note            String?
  // Set when the investment was closed (Close investment), null while open.
  closedAt        DateTime?            @db.Date
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  entries         InvestmentEntry[]

  @@index([businessId])
}

// One thing that happened to an investment: the first money put in, more
// put in, a profit, capital back, or a loss.
model InvestmentEntry {
  id            String              @id @default(uuid())
  investmentId  String
  investment    Investment          @relation(fields: [investmentId], references: [id])
  businessId    String
  type          InvestmentEntryType
  date          DateTime            @db.Date
  amount        Decimal             @db.Decimal(14, 2)
  // The wallet the money left or came into; null for a loss and for money
  // put in earlier, before the app (no money moved). Loose string FK.
  accountId     String?
  // Its posting (null when no money moved). Unique: a posting belongs to
  // one entry.
  transactionId String?             @unique
  note          String?
  // Made by Close investment, so Undo of the close takes exactly these.
  fromClose     Boolean             @default(false)
  createdAt     DateTime            @default(now())

  @@index([investmentId])
  @@index([businessId, date])
}

// An investment or an entry deleted in the last few minutes, kept so the
// delete can be undone, like AssetDeletion: the rows as they were
// (snapshot) and who deleted them. Their postings stay voided until the
// undo brings them back; housekeeping removes the row after the window.
model InvestmentDeletion {
  // The deleted investment's id, or the deleted entry's.
  id           String   @id
  kind         String // 'INVESTMENT' | 'ENTRY'
  businessId   String
  investmentId String
  deletedBy    String
  deletedAt    DateTime @default(now())
  snapshot     Json

  @@index([deletedAt])
}

enum InvestmentKind {
  BUSINESS
  SANCHAYAPATRA
  FDR
  SHARES
  PROPERTY
  OTHER
}

enum InvestmentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  IRREGULAR
}

enum InvestmentPayoutMode {
  FIXED
  RATE
  NONE
}

enum InvestmentEntryType {
  INVEST
  ADD
  PROFIT
  BACK
  LOSS
}

// =====================================================================
// "Referral Program" menu -- every user gets their own shareable
// referralCode (see User.referralCode); a new signup that includes someone
// else's code in RegisterDto creates one Referral row here linking the two.
// =====================================================================

// One referral relationship: referrer invited referredUser, who signed up
// with the referrer's referralCode.
//
// A COMMISSION row (every sign-up since the commission rules): JOINED at
// sign-up -> PENDING when the friend's first payment is confirmed (the
// referrer earns commissionRate % of what the friend paid, held for the
// refund window until availableAt) -> AVAILABLE -> PAID_OUT once payout
// requests have covered it (paidOutAmount, FIFO by availableAt). CANCELLED
// when the friend is refunded inside the window, the referrer wasn't on a
// paid plan when the friend paid, the sign-up looked like self-referral,
// or an admin cancelled it (cancelReason).
//
// A SIGNUP_BONUS row is the old rule (a flat rewardAmount 30 days after the
// friend signed up): commissionAmount = rewardAmount, PENDING until
// availableAt, then withdrawable like a commission. CONFIRMED / WITHDRAWN
// are the old rule's statuses, kept only so a rollback can still read the
// table; nothing writes them (the migration moved them to AVAILABLE /
// PAID_OUT).
model Referral {
  id               String               @id @default(uuid())
  referrerId       String
  referrer         User                 @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId   String               @unique
  referredUser     User                 @relation("Referred", fields: [referredUserId], references: [id])
  // The old rule's flat reward (a snapshot of referral_reward_amount); 0
  // for a commission row.
  rewardAmount     Decimal              @db.Decimal(14, 2)
  status           ReferralStatus       @default(JOINED)
  kind             ReferralKind         @default(COMMISSION)
  // The friend's first confirmed payment, and what they paid for it.
  paymentId        String?              @unique
  payment          Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paidAmount       Decimal?             @db.Decimal(14, 2)
  // Snapshots at the friend's payment: the rate (20.00 = 20 %) and the
  // commission, rounded down to whole taka.
  commissionRate   Decimal?             @db.Decimal(5, 2)
  commissionAmount Decimal?             @db.Decimal(14, 2)
  // When the commission leaves the refund window (paidAt + hold days).
  availableAt      DateTime?
  // How much of commissionAmount paid payout requests have covered.
  paidOutAmount    Decimal              @default(0) @db.Decimal(14, 2)
  paidOutAt        DateTime?
  cancelledAt      DateTime?
  // FRIEND_REFUNDED | REFERRER_NOT_ON_PAID_PLAN | PROGRAM_OFF |
  // SELF_REFERRAL | MONTHLY_LIMIT | ADMIN
  cancelReason     String?
  confirmedAt      DateTime?
  withdrawnAt      DateTime?
  createdAt        DateTime             @default(now())
  allocations      PayoutAllocation[]
  // The invite link (Referrals > Invite links) the friend signed up from;
  // null = the main link, or a sign-up from before links had tags.
  linkId           String?
  link             ReferralLink?        @relation(fields: [linkId], references: [id], onDelete: SetNull)
  // One per payment of the friend's (ReferralCommission). The money
  // columns above are the pre-v9 record of the first payment only.
  commissions      ReferralCommission[]

  @@index([referrerId])
  @@index([referrerId, status])
  @@index([status, availableAt])
}

enum ReferralStatus {
  JOINED
  PENDING
  AVAILABLE
  PAID_OUT
  CANCELLED
  // The old rule's statuses; nothing writes them any more.
  CONFIRMED
  WITHDRAWN
}

enum ReferralKind {
  SIGNUP_BONUS
  COMMISSION
}

enum PayoutMethodType {
  BKASH
  NAGAD
  ROCKET
  BANK
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

// Where a member wants their referral money sent: a bKash, Nagad or Rocket
// number (a personal account), or a bank account. Deleting one only hides
// it (deletedAt): a payout request keeps its own snapshot anyway.
model PayoutMethod {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PayoutMethodType
  // The name on the account; it must match the member's own name (checked
  // softly, shown to the admin).
  accountName     String
  // BKASH / NAGAD / ROCKET: 01XXXXXXXXX (Rocket may add a twelfth digit).
  walletNumber    String?
  bankName        String?
  branch          String?
  bankAccountType BankAccountType?
  accountNumber   String?
  // Nine digits.
  routingNumber   String?
  isDefault       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payoutRequests  PayoutRequest[]

  @@index([userId])
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

// A member's withdrawal of referral money. REQUESTED (the money is set
// aside: the balance counts it as taken; the member may cancel) ->
// APPROVED (an admin checked it) -> PAID (the admin sent it and recorded
// the transaction id). REQUESTED or APPROVED -> REJECTED gives the money
// back to the balance, as does the member's CANCELLED.
model PayoutRequest {
  id                  String               @id @default(uuid())
  // Shown as WD-1048.
  number              Int                  @unique @default(autoincrement())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  // The lines' total (less any an admin held back at approval); the
  // member receives amount - fee.
  amount              Decimal              @db.Decimal(14, 2)
  // The lines' total when it was asked for; null on pre-v9 requests.
  requestedAmount     Decimal?             @db.Decimal(14, 2)
  // The commission lines it was made of, kept after a reject or cancel
  // gives them back (each line's payoutId says where it is now).
  lineIds             String[]             @default([])
  fee                 Decimal              @default(0) @db.Decimal(14, 2)
  methodId            String?
  method              PayoutMethod?        @relation(fields: [methodId], references: [id], onDelete: SetNull)
  // The method as it was when requested: type, names and numbers.
  methodSnapshot      Json
  status              PayoutStatus         @default(REQUESTED)
  // "Add it as income when it's paid": the member's workspace and wallet,
  // and the posting made at Mark paid.
  incomeBusinessId    String?
  incomeAccountId     String?
  incomeTransactionId String?
  codeConfirmedAt     DateTime
  approvedAt          DateTime?
  approvedBy          String?
  paidAt              DateTime?
  // What the admin actually sent.
  paidAmount          Decimal?             @db.Decimal(14, 2)
  trxId               String?
  rejectedAt          DateTime?
  rejectReason        String?
  cancelledAt         DateTime?
  // The admin who paid or rejected it.
  processedBy         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  allocations         PayoutAllocation[]
  // The commission lines it is made of (and, UNDER_CHECK, the ones an
  // admin held back from it).
  commissions         ReferralCommission[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Which commissions a paid payout covered, and how much of each (FIFO by
// availableAt): "why this member was owed this".
model PayoutAllocation {
  id         String        @id @default(uuid())
  payoutId   String
  payout     PayoutRequest @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  referralId String
  referral   Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(14, 2)
  createdAt  DateTime      @default(now())

  @@index([payoutId])
  @@index([referralId])
}

// Where a commission is (Referrals > Earnings):
//   ON_HOLD        inside the refund window (paidAt + hold days)
//   AVAILABLE      ready to withdraw
//   IN_WITHDRAWAL  ticked into a payout request that is not paid yet
//   UNDER_CHECK    an admin held it back from a request for a second look
//   PAID_OUT       paid in its payout request
//   REVERSED       the friend was refunded inside the window
//   CANCELLED      never earned (program off, referrer on the free plan) or
//                  cancelled by an admin; cancelReason says which
enum CommissionStatus {
  ON_HOLD
  AVAILABLE
  IN_WITHDRAWAL
  UNDER_CHECK
  PAID_OUT
  REVERSED
  CANCELLED
}

// FIRST = the friend's first payment, RENEWAL = any later one, BONUS = an
// old flat sign-up bonus (before commissions).
enum CommissionKind {
  FIRST
  RENEWAL
  BONUS
}

// The referrer's share of one payment of an invited friend's: every paid
// payment earns one (renewals too) while the referrer can earn. Made in
// the payment's own transaction (BillingHooks), and withdrawn whole: a
// payout request is a set of these lines.
model ReferralCommission {
  id           String           @id @default(uuid())
  referralId   String
  referral     Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId   String
  referrer     User             @relation(fields: [referrerId], references: [id])
  // Null for an old sign-up bonus, or the paid-out part of an old
  // commission that was partly paid (split off when v9 came in).
  paymentId    String?          @unique
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  kind         CommissionKind
  // What the friend paid, the rate (20.00 = 20 %) and the share, rounded
  // down to whole taka.
  paidAmount   Decimal          @db.Decimal(14, 2)
  rate         Decimal          @db.Decimal(5, 2)
  amount       Decimal          @db.Decimal(14, 2)
  status       CommissionStatus
  // When it leaves the refund window.
  availableAt  DateTime
  // The request it is in (IN_WITHDRAWAL), was held back from (UNDER_CHECK)
  // or was paid in (PAID_OUT).
  payoutId     String?
  payout       PayoutRequest?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  // FRIEND_REFUNDED | REFERRER_NOT_ON_PAID_PLAN | PROGRAM_OFF | ADMIN
  cancelReason String?
  paidOutAt    DateTime?
  // When it was reversed or cancelled.
  endedAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([referrerId, status])
  @@index([referralId])
  @@index([status, availableAt])
  @@index([payoutId])
}

// Referrals > Invite links: one referral code, shared in many places, each
// with its own tag (/register?ref=CODE&src=facebook) so the member sees
// which place brings people. tag "" is the main link (no src).
model ReferralLink {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  tag       String
  // Opens of the link (counted once per visitor session by the sign-up page).
  clicks    Int        @default(0)
  // Deleted links keep their name on the friends who came from them.
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  referrals Referral[]

  @@unique([userId, tag])
}

enum OneTimeCodePurpose {
  PAYOUT_REQUEST
  // Resetting the Password Manager's vault password.
  VAULT_RESET
  // A password reset link, for an account with "Ask for a code before a
  // password reset" on.
  PASSWORD_RESET
  // Proving a phone number with a code sent to it.
  PHONE_VERIFY
  // "Forgot password" by a verified phone: the code is the proof.
  PHONE_PASSWORD_RESET
  // The Password Manager's second unlock step, after the vault password.
  VAULT_UNLOCK
  // Proving a recovery email with a code sent to it (Settings › Security).
  RECOVERY_EMAIL
}

enum OneTimeCodeChannel {
  EMAIL
  SMS
}

// A six-digit code sent to the member to confirm something (a payout
// request). Only its hash is kept (sha256 of code + id); `payload` is what
// the code confirms, re-checked when it is used. At most five wrong tries
// and five sends; it lapses after ten minutes and works once.
model OneTimeCode {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     OneTimeCodePurpose
  channel     OneTimeCodeChannel
  destination String
  codeHash    String
  payload     Json
  attempts    Int                @default(0)
  sends       Int                @default(1)
  expiresAt   DateTime
  consumedAt  DateTime?
  lastSentAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// =====================================================================
// "Group Expense" (মেস/যৌথ হিসাব) -- a GROUP-type workspace for a mess or
// joint family splitting shared costs. Deliberately NOT built on the
// Account/Transaction double-entry engine: this is a much simpler "pool in
// (contributions), pool out (expenses), split the remainder equally"
// ledger, not real bookkeeping -- forcing it through Account/Transaction,
// or through Contact's debt-sign-convention (built for customer/supplier
// trade), would distort both. GroupMember is a name/phone record; the
// owner records for everyone. A member the owner gives access (Viewer or
// Editor) gets an access link, makes a login with it (or adds the group to
// the Smartly account they have) and is then a BusinessMember too: STAFF
// for a Viewer, ACCOUNTANT for an Editor (src/group-access).
// =====================================================================

model GroupMember {
  id            String                  @id @default(uuid())
  businessId    String
  business      Business                @relation(fields: [businessId], references: [id])
  name          String
  phone         String?
  photoUrl      String?
  status        GroupMemberStatus       @default(ACTIVE)
  // Their share of costs split "by shares" (a brother with a family of
  // three takes 3).
  shareUnits    Decimal                 @default(1) @db.Decimal(6, 2)
  // When they joined and left: they share only the costs of the days in
  // between. Null joinedOn = from the start; null leftOn = still here.
  joinedOn      DateTime?               @db.Date
  leftOn        DateTime?               @db.Date
  // Member: gives money to an accountant, no access. Viewer: may open the
  // group and see everything. Accountant ("Editor"): keeps cash and does
  // the bazar, and may add money entries in their own name (up to 2 active
  // in a group).
  role          GroupMemberRole         @default(MEMBER)
  // The login that opens the group as this member, once they used their
  // access link. Its access lives on BusinessMember (status ACTIVE while
  // the role gives access).
  userId        String?
  user          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessLink    GroupAccessLink?
  // The group's owner (the signed-in customer): can't be removed or made
  // inactive.
  isOwner       Boolean                 @default(false)
  // Who this member's share covers ("Khaled, wife and daughter").
  household     String?
  // Their percent of costs shared by the cost split, when the group's split
  // is CUSTOM (active members add up to 100).
  costPercent   Decimal?                @db.Decimal(5, 2)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  contributions GroupContribution[]     @relation("ContributionMember")
  received      GroupContribution[]     @relation("ContributionReceiver")
  // Group cash they handed to another holder, and cash handed to them.
  handoversOut  GroupCashHandover[]     @relation("HandoverFrom")
  handoversIn   GroupCashHandover[]     @relation("HandoverTo")
  // GroupExpense.paidByMemberId: who paid it -- out of their own pocket
  // when the expense says so (paidFrom MEMBER), which credits them.
  expensesPaid  GroupExpense[]
  settlements   GroupSettlementMember[]
  splits        GroupExpenseSplit[]
  meals         GroupMeal[]

  // One login per member record, and a login is one member of a group.
  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([userId])
}

// An access link the owner sends a member (Members › Give access, or a
// password reset). Only its SHA-256 is looked up; the token itself is kept
// sealed (AES-GCM, GROUP_LINK_ENCRYPTION_KEY or the two-step key) so the
// owner can copy it again while it waits, or null without a key. One live
// link per member: a new one replaces the old, and using it deletes it.
model GroupAccessLink {
  id              String              @id @default(uuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id])
  groupMemberId   String              @unique
  groupMember     GroupMember         @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  kind            GroupAccessLinkKind
  tokenHash       String              @unique
  tokenSealed     String?
  createdByUserId String
  expiresAt       DateTime
  createdAt       DateTime            @default(now())

  @@index([businessId])
}

// JOIN: make a login (or add the group to a Smartly account). RESET: a new
// password for the login the member already has.
enum GroupAccessLinkKind {
  JOIN
  RESET
}

// A group's own settings (one row, made when first saved): a family or a
// mess, the day its month starts, who holds the cash, and meal counting
// with what each meal counts for.
model GroupSettings {
  id                 String         @id @default(uuid())
  businessId         String         @unique
  business           Business       @relation(fields: [businessId], references: [id])
  kind               GroupKind      @default(FAMILY)
  monthStartDay      Int            @default(1) // 1-28
  cashHolderMemberId String?
  mealsOn            Boolean        @default(false)
  breakfastUnits     Decimal        @default(0.5) @db.Decimal(4, 2)
  lunchUnits         Decimal        @default(1) @db.Decimal(4, 2)
  dinnerUnits        Decimal        @default(1) @db.Decimal(4, 2)
  // How costs shared "by cost split" are weighted: everyone the same, or
  // each active member's costPercent.
  costSplit          GroupCostSplit @default(EQUAL)
  // The custom split was worked out from members' shares (and follows them
  // when shares change); false: the owner set the percents by hand.
  splitFromShares    Boolean        @default(false)
  // Warn once this much of a month's budget is spent; null = never.
  budgetWarnPercent  Int?           @default(90)
  // How a category made from now on is shared to start with (Settings).
  newCategorySplit   GroupSplit     @default(EQUAL)
  // The group's first month ("2026-04"); null: its first member's. Months
  // before it are not offered (the v16 Settings board).
  firstMonth         String?
  // Paused: kept out of new entries and listed last. Nothing is deleted.
  pausedAt           DateTime?
  updatedAt          DateTime       @updatedAt
}

enum GroupCostSplit {
  EQUAL
  CUSTOM
}

enum GroupMemberRole {
  MEMBER
  ACCOUNTANT
  VIEWER
}

enum GroupKind {
  FAMILY
  MESS
  // A trip or an office: everything shared equally, like a mess without meals.
  TRIP
  OFFICE
}

// How an expense is shared: equally (everyone that day, or the members it
// names), by shares, by meals (pooled into one meal rate), or by exact
// amounts.
enum GroupSplit {
  EQUAL
  SHARES
  MEALS
  EXACT
}

// How a member paid another to settle up.
enum GroupPayMethod {
  CASH
  BKASH
  NAGAD
  BANK
}

enum GroupPaidFrom {
  FUND
  MEMBER
}

// A deposit, money given back, a settling-up payment between members, or a
// balance carried into the next month on close. Returns stay negative
// amounts as before; the kind says which.
enum GroupContributionKind {
  DEPOSIT
  RETURN
  SETTLE
  CARRY
}

// The members an expense names, with their units (by shares) or amounts
// (exact). An expense with none is shared by everyone in the group that day.
model GroupExpenseSplit {
  id            String       @id @default(uuid())
  expenseId     String
  expense       GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  groupMemberId String
  groupMember   GroupMember  @relation(fields: [groupMemberId], references: [id])
  units         Decimal?     @db.Decimal(8, 2)
  amount        Decimal?     @db.Decimal(14, 2)

  @@unique([expenseId, groupMemberId])
}

// One member's meals on one day: how many of each, and guests' meals.
model GroupMeal {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id])
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id])
  date          DateTime    @db.Date
  breakfast     Int         @default(0)
  lunch         Int         @default(0)
  dinner        Int         @default(0)
  guests        Decimal     @default(0) @db.Decimal(4, 1)
  updatedAt     DateTime    @updatedAt

  @@unique([groupMemberId, date])
  @@index([businessId, date])
}

enum GroupMemberStatus {
  ACTIVE
  ARCHIVED
}

// Group cash moving from one holder to another (the v16 Cash book's "Hand
// over cash"): it changes who keeps the cash, never anyone's balance.
model GroupCashHandover {
  id              String      @id @default(uuid())
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id])
  fromMemberId    String
  fromMember      GroupMember @relation("HandoverFrom", fields: [fromMemberId], references: [id])
  toMemberId      String
  toMember        GroupMember @relation("HandoverTo", fields: [toMemberId], references: [id])
  amount          Decimal     @db.Decimal(14, 2)
  date            DateTime    @db.Date
  note            String?
  // Who recorded it (an Editor changes only their own); null = the owner,
  // before logins existed.
  createdByUserId String?
  createdAt       DateTime    @default(now())

  @@index([businessId, date])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model GroupContribution {
  id                 String                @id @default(uuid())
  businessId         String
  business           Business              @relation(fields: [businessId], references: [id])
  groupMemberId      String
  groupMember        GroupMember           @relation("ContributionMember", fields: [groupMemberId], references: [id])
  amount             Decimal               @db.Decimal(14, 2)
  kind               GroupContributionKind @default(DEPOSIT)
  date               DateTime              @db.Date
  note               String?
  // The accountant whose cash it went into ("Given to"); null on older rows,
  // which count as the cash holder's.
  receivedByMemberId String?
  receivedBy         GroupMember?          @relation("ContributionReceiver", fields: [receivedByMemberId], references: [id])
  // The same id on both rows of one settle-up, so Undo removes the pair.
  settleGroupId      String?
  // How a settle-up was paid (Settlement's "How"); null on other rows.
  payMethod          GroupPayMethod?
  // Who recorded it (an Editor changes only their own); null = the owner,
  // before logins existed.
  createdByUserId    String?
  createdAt          DateTime              @default(now())

  @@index([businessId, date])
  @@index([groupMemberId])
  @@index([businessId, receivedByMemberId])
  @@index([settleGroupId])
}

model GroupExpense {
  id              String              @id @default(uuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id])
  amount          Decimal             @db.Decimal(14, 2)
  date            DateTime            @db.Date
  // Loose string, NOT a categoryId FK to GroupExpenseCategoryOption -- same
  // "picker list is decoupled from what's stored" convention as
  // Asset.category/AssetCategoryOption (see that model's own comment):
  // deleting a category option must never break/cascade-delete existing
  // expenses, it should just stop being offered for NEW ones.
  category        String              @default("Other")
  description     String?
  paidByMemberId  String?
  paidByMember    GroupMember?        @relation(fields: [paidByMemberId], references: [id])
  // FUND: out of the group's cash. MEMBER: out of paidByMember's pocket,
  // credited to them.
  paidFrom        GroupPaidFrom       @default(FUND)
  split           GroupSplit          @default(EQUAL)
  splits          GroupExpenseSplit[]
  // Who recorded it (an Editor changes only their own); null = the owner,
  // before logins existed.
  createdByUserId String?
  createdAt       DateTime            @default(now())

  @@index([businessId, date])
}

// The editable picker list behind GroupExpense.category (see that field's
// comment on why it's a loose string, not a real FK to this table) -- same
// shape and same lazy-default-seeding pattern as AssetCategoryOption
// (AssetsService.listCategories()): the first four (Grocery/Rent/Utility/
// Other) are seeded once per business the first time its category list is
// ever requested, editable/deletable after that like any other row.
model GroupExpenseCategoryOption {
  id               String     @id @default(uuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id])
  name             String
  icon             String?
  color            String
  displayOrder     Int        @default(0)
  // How a new expense in this category is shared, to start with.
  defaultSplit     GroupSplit @default(EQUAL)
  // "Only selected": the members a new expense in it is shared by, equally
  // (defaultSplit EQUAL). Empty = everyone in the group that day.
  defaultMemberIds String[]   @default([])
  // Hidden: not offered for new expenses; old records keep it.
  hidden           Boolean    @default(false)
  // What it may spend in a month; null: no limit (the v16 Budget board).
  monthlyLimit     Decimal?   @db.Decimal(14, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([businessId, name])
}

// Group Expense's activity log: who added, changed or deleted what, and
// when a month was closed. Written by every change; never edited.
model GroupActivity {
  id          String              @id @default(uuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id])
  actorUserId String?
  action      GroupActivityAction
  // EXPENSE, CONTRIBUTION, MEMBER, CATEGORY, BUDGET, SETTINGS, SPLIT, MONTH
  entity      String
  entityId    String?
  // What it was about: { name, amount, category, member, date, note, ... }.
  summary     Json
  // What changed: [{ field, from, to }].
  change      Json?
  createdAt   DateTime            @default(now())

  @@index([businessId, createdAt])
}

enum GroupActivityAction {
  ADDED
  EDITED
  DELETED
  MONTH
}

// A manually-entered monthly budget target (Month + Year + amount, typed in
// by the user via the Dashboard's "Add Month" form on the Monthly Breakdown
// card) -- deliberately NOT computed from real GroupExpense/
// GroupContribution rows the way an earlier version of this was; it's a
// plain standalone record with no comparison-to-actuals logic beyond what
// the Dashboard already computes client-side. One row per (businessId,
// month, year).
model GroupMonthlyBudget {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  month        Int // 1-12
  year         Int
  budgetAmount Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, month, year])
}

// A "closed" snapshot of one period's settlement (see
// GroupExpensesService.closeSettlement()) -- once closed, later back-dated
// contributions/expenses falling inside that period never change these
// stored numbers, only a new, still-open period's live computation.
model GroupSettlement {
  id             String                  @id @default(uuid())
  businessId     String
  business       Business                @relation(fields: [businessId], references: [id])
  periodStart    DateTime                @db.Date
  periodEnd      DateTime                @db.Date
  totalExpense   Decimal                 @db.Decimal(14, 2)
  memberCount    Int
  // The even base share (totalExpense / memberCount, rounded) -- the actual
  // per-member share used for that member's balance is on
  // GroupSettlementMember.share, since one member absorbs the rounding
  // remainder so shares always sum exactly to totalExpense.
  perMemberShare Decimal                 @db.Decimal(14, 2)
  // Meals at the time it closed, and the cash then in hand.
  mealExpense    Decimal                 @default(0) @db.Decimal(14, 2)
  mealUnits      Decimal                 @default(0) @db.Decimal(10, 2)
  mealRate       Decimal                 @default(0) @db.Decimal(14, 4)
  cashInHand     Decimal                 @default(0) @db.Decimal(14, 2)
  // Each balance was carried into the next month as a CARRY contribution.
  carriedForward Boolean                 @default(false)
  closedBy       String
  closedAt       DateTime                @default(now())
  members        GroupSettlementMember[]

  @@index([businessId, periodStart])
}

model GroupSettlementMember {
  id            String          @id @default(uuid())
  settlementId  String
  settlement    GroupSettlement @relation(fields: [settlementId], references: [id])
  groupMemberId String
  groupMember   GroupMember     @relation(fields: [groupMemberId], references: [id])
  contributed   Decimal         @db.Decimal(14, 2)
  pocketPaid    Decimal         @default(0) @db.Decimal(14, 2)
  mealUnits     Decimal         @default(0) @db.Decimal(10, 2)
  mealCost      Decimal         @default(0) @db.Decimal(14, 2)
  share         Decimal         @db.Decimal(14, 2)
  // contributed - share: positive = this member should get money back,
  // negative = this member still owes the pool.
  balance       Decimal         @db.Decimal(14, 2)

  @@index([settlementId])
}

// The bell's feed in the customer app. Written by the reminder checks
// (budget, loan due dates, savings check-ins) and by announcements; `key`
// names what a row is about (e.g. "budget:<categoryId>:2026-10:90"), so a
// check that runs again adds nothing new. The text is built from `data`
// in the reader's language, never stored.
model UserNotification {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The workspace it is about; null for an announcement.
  businessId String?
  type       UserNotificationType
  key        String
  data       Json
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt])
}

enum UserNotificationType {
  BUDGET
  LOAN_DUE
  SAVINGS
  ANNOUNCEMENT
  // The support team answered one of the customer's messages.
  SUPPORT_REPLY
  // A Habit Tracker reminder came due (RemindersScheduler).
  REMINDER
  // A payment was confirmed, failed or refunded, or the plan is ending.
  BILLING
  // A friend bought a plan, or a commission became withdrawable or was
  // cancelled (Referral Program).
  REFERRAL
  // A referral withdrawal was approved, paid or rejected.
  PAYOUT
  // Two-step sign-in was turned on or off (by the customer or the support
  // team), or a new device signed in.
  SECURITY
  // An in-app message from an admin campaign.
  CAMPAIGN
  // A feature request the customer voted for changed status.
  IDEA
  // The zakat date is 30 or 3 days away and some zakat is left to give.
  ZAKAT
  // An event the customer asked to be reminded of is tomorrow.
  EVENT
  // AI Insights' morning summary: what needs attention today.
  INSIGHT
}

// A browser or phone that gets web push notifications for one customer
// (Settings > App > Reminders). `endpoint` is the push service's address for
// that device; signing in as someone else on it moves the row to them.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  // "en" | "bn": the language this device's notifications are written in.
  locale     String   @default("en")
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum ReminderKind {
  HABIT
  CHALLENGE
  TODO
  NAMAZ
  RAMADAN
  BOOK
  SKILL
}

// A timed Habit Tracker reminder, fired by RemindersScheduler into the bell
// (and as a push). `targetKey` names what it is for: a Habit.id (HABIT), a
// HabitMonthTracker.id (CHALLENGE), a Book.id (BOOK), a Skill.id (SKILL),
// "fajr" | "dhuhr" | "asr" | "maghrib" | "isha" (NAMAZ) or "sehri" | "iftar"
// (RAMADAN). A plain string, not a foreign key: the services' delete paths
// remove the rows of what they delete. To-do reminders live on the task
// itself (TodoItem.remindBefore).
model Reminder {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          ReminderKind
  targetKey     String
  enabled       Boolean      @default(true)
  // "HH:MM" on a 24-hour clock, Dhaka time (HABIT/CHALLENGE/BOOK/SKILL, 1-6
  // of them); empty for NAMAZ/RAMADAN, whose times are worked out daily.
  times         String[]
  // 0 = Sunday ... 6 = Saturday; empty = every day. HABIT/CHALLENGE/BOOK/SKILL.
  weekdays      Int[]
  // NAMAZ/RAMADAN: this many minutes before the computed time (0-120).
  minutesBefore Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, kind, targetKey])
  @@index([enabled, kind])
}

// =====================================================================
// Zakat (Zakat calculator). The amount is worked out on every read from the
// workspace's own records -- wallets, savings, gold and investments in
// Assets, and what contacts owe or are owed -- so no money figure is stored
// here except what the member added by hand and what they recorded giving.
// =====================================================================

// Gold and silver as BAJUS prices them, per vori.
enum ZakatMetal {
  GOLD_22
  GOLD_21
  GOLD_18
  GOLD_TRADITIONAL
  SILVER_22
}

// The nisab followed: 52.5 vori of silver (the lower) or 7.5 vori of gold.
enum ZakatBasis {
  SILVER
  GOLD
}

// When the zakat year is due: 1 Ramadan, 1 Muharram (the next one on the
// Umm al-Qura calendar), or the member's own date each year.
enum ZakatDateMode {
  RAMADAN
  MUHARRAM
  CUSTOM
}

// The steps of "Check your numbers" a hand-added line belongs to.
enum ZakatGroup {
  CASH
  SAVINGS
  GOLD
  INVESTMENTS
  OWED_TO_YOU
  YOU_OWE
}

// A workspace's zakat choices.
model ZakatProfile {
  id          String        @id @default(uuid())
  businessId  String        @unique
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  basis       ZakatBasis    @default(SILVER)
  dateMode    ZakatDateMode @default(RAMADAN)
  // CUSTOM: the day of the year it is due ("2027-01-15"; the month and day
  // repeat every year).
  customDate  String?
  // The member's own prices per vori (22 karat); null: the platform's.
  goldPrice   Decimal?      @db.Decimal(14, 2)
  silverPrice Decimal?      @db.Decimal(14, 2)
  // Lines left out of the sum ("account:<id>", "contact:<id>", "asset:<id>").
  excluded    String[]      @default([])
  // Contacts whose whole debt is taken off, not only what is due within 12 months.
  debtFull    String[]      @default([])
  // Assets (land, a flat) bought to sell: counted under investments.
  forSale     String[]      @default([])
  // "Yes, this is right" for the year it was said in: { "dueDate": ..., "steps": [...] }.
  checked     Json?
  // The zakat last worked out, and for which due date (the bell reminds
  // only while some of it is left to give).
  lastZakat   Decimal?      @db.Decimal(14, 2)
  lastDueDate String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Something the member has but didn't put in the app: cash at home, a
// provident fund, gold by weight, a debt. Only the zakat page counts it.
model ZakatExtra {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group      ZakatGroup
  name       String
  // Money lines; gold and silver come by metal and weight instead.
  amount     Decimal?    @db.Decimal(14, 2)
  metal      ZakatMetal?
  weightVori Decimal?    @db.Decimal(10, 3)
  createdAt  DateTime    @default(now())

  @@index([businessId])
}

// Zakat given: an expense under the Zakat category from one wallet, for the
// zakat year due on dueDate.
model ZakatPayment {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dueDate       String
  amount        Decimal  @db.Decimal(14, 2)
  paidOn        DateTime @db.Date
  accountId     String
  transactionId String   @unique
  givenTo       String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([businessId, dueDate])
}

// =====================================================================
// Calendar & Events: invitations and the customer's own events
// (weddings, aqiqahs, birthdays...), and the gifts given and received at
// them -- who gave what, both ways, over the years. A record of social
// giving, not a money posting: a cash gift does not move a wallet.
// =====================================================================

enum SocialEventType {
  WEDDING
  HOLUD
  AQIQAH
  KHATNA
  BIRTHDAY
  MILAD
  EID
  OTHER
}

// GAVE: at someone else's event; GOT: at the customer's own.
enum GiftDirection {
  GAVE
  GOT
}

// CASH, or an ITEM (a gold ring) written down at its value.
enum GiftKind {
  CASH
  ITEM
}

// Settings › Data & privacy › Backup and restore: a copy of the money
// records in every workspace the person owns, kept in Smartly (gzipped
// JSON, one array of rows per table). Password Manager and the Habit
// Tracker are not in it.
model DataBackup {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       DataBackupKind
  // Bytes stored (gzipped), and bytes of the records it holds.
  size       Int
  rawSize    Int
  // sha-256 of the records: an automatic copy identical to the newest one
  // is not kept twice.
  hash       String
  workspaces Int
  data       Bytes
  createdAt  DateTime       @default(now())

  @@index([userId, createdAt])
}

enum StartPage {
  DASHBOARD
  REPORTS
  INCOME_EXPENSE
  GROUP
  CALENDAR
}

enum FiscalYearStart {
  JANUARY
  JULY
}

enum Gender {
  MALE
  FEMALE
  UNSAID
}

enum DataBackupKind {
  AUTO
  MANUAL
  // Taken just before a restore, so the restore can be undone.
  BEFORE_RESTORE
}

enum BackupEvery {
  DAILY
  WEEKLY
}

// The parts of a person's records AI Insights may read (User.aiReads).
enum AiSection {
  TRANSACTIONS
  SAVINGS
  LOANS
  GROUPS
  BUDGET
  ASSETS
}

// Someone gifts go to or come from: a cousin, a colleague.
model EventPerson {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  // How they are related ("Cousin", "Uncle"), as typed.
  relation   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  hosted     SocialEvent[]
  gifts      EventGift[]

  @@index([businessId])
}

model SocialEvent {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       SocialEventType
  title      String
  date       DateTime        @db.Date
  // "HH:MM" in Asia/Dhaka, when given.
  time       String?
  place      String?
  // Whose event it is; null for the customer's own.
  hostId     String?
  host       EventPerson?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  remind     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  gifts      EventGift[]

  @@index([businessId, date])
  @@index([hostId])
}

model EventGift {
  id            String        @id @default(uuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventId       String
  event         SocialEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId      String
  person        EventPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  direction     GiftDirection
  kind          GiftKind
  // The item, for an ITEM gift ("Gold ring").
  item          String?
  // Cash given, or what the item is worth.
  amount        Decimal       @db.Decimal(14, 2)
  note          String?
  // Cash given that was also added to Transactions: its expense, which
  // only deleting the gift (or its event) voids.
  transactionId String?       @unique
  createdAt     DateTime      @default(now())

  @@index([businessId])
  @@index([eventId])
  @@index([personId])
}
