generator client {
  provider = "prisma-client-js"
}

// Prisma 7: no `url` here -- the connection string lives in prisma.config.ts
// (for the CLI/migrations) and is passed explicitly as a driver adapter to
// the PrismaClient constructor at runtime (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// --- Admin domain only for now. End-user tables (transactions, accounts, etc.)
// come later in the separate user-app build plan. ---

model AdminUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdBy    String? // loose reference to the AdminUser (usually SUPER_ADMIN) who created this account, if any
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]

  // Note: no separate @@index([email]) here -- @unique already creates a
  // unique index covering lookups by email, so a second index would be
  // redundant.
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AuditLog {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String // e.g. "ADMIN_LOGIN", "USER_SUSPENDED", "PLAN_UPDATED"
  entityType  String // e.g. "AdminUser", "PlatformUser", "SubscriptionPlan"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// --- Prompt 2: User Management (admin's view of the SaaS's platform users,
// not the end-user app's own data model). When the real end-user app schema
// is built later (separate 20-prompt plan), this model will either be merged
// into it or referenced from it. `plan` already points at the real
// SubscriptionPlan model (added in Prompt 3) rather than a placeholder stub. ---

model PlatformUser {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  phone           String?
  status          PlatformUserStatus @default(ACTIVE)
  planId          String?
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id])
  workspaceCount  Int                @default(1)
  signupSource    String? // e.g. "web", "referral"
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // No separate @@index([email]) -- @unique above already covers it.
  @@index([status])
  @@index([createdAt])
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

// --- Prompt 3: Subscriptions (plans, coupons, and plan-change history). ---

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String // e.g. "Free", "Monthly Pro", "Yearly Pro", "Business"
  slug          String             @unique // e.g. "free", "monthly-pro"
  billingCycle  BillingCycle
  price         Decimal            @db.Decimal(10, 2)
  currency      String             @default("BDT")
  trialDays     Int                @default(0)
  isActive      Boolean            @default(true)
  featureLimits Json // e.g. { "maxWorkspaces": 1, "maxBusinessWorkspaces": 0, "maxTransactionsPerMonth": 100, "advancedReports": false, "pdfExport": false, "multiUser": false }
  displayOrder  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         PlatformUser[]
  couponUsages  CouponRedemption[]
  payments      Payment[]
  businesses    Business[] // end-user app (Prompt 1): workspaces on this plan
}

enum BillingCycle {
  FREE
  MONTHLY
  YEARLY
}

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  maxRedemptions  Int? // null = unlimited
  timesRedeemed   Int          @default(0)
  validFrom       DateTime
  validUntil      DateTime
  applicablePlans String[] // array of SubscriptionPlan.id, empty = applies to all
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  redemptions     CouponRedemption[]
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CouponRedemption {
  id             String           @id @default(uuid())
  couponId       String
  coupon         Coupon           @relation(fields: [couponId], references: [id])
  platformUserId String
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  redeemedAt     DateTime         @default(now())
}

model PlanChangeLog {
  id             String   @id @default(uuid())
  platformUserId String
  fromPlanId     String?
  toPlanId       String
  changedBy      String // AdminUser id, or "SYSTEM" if automated
  reason         String?
  createdAt      DateTime @default(now())
}

// --- Prompt 4: Payments (payments, invoices, refunds). ---

model Payment {
  id                 String           @id @default(uuid())
  platformUserId     String
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  amount             Decimal          @db.Decimal(10, 2)
  currency           String           @default("BDT")
  discountApplied    Decimal?         @db.Decimal(10, 2)
  couponId           String?
  gateway            PaymentGateway
  gatewayReferenceId String? // transaction id from bKash/SSLCommerz/etc, nullable until real integration
  status             PaymentStatus
  failureReason      String?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  invoice            Invoice?
  refund             Refund?

  @@index([platformUserId, createdAt])
  @@index([status])
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Invoice {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  invoiceNumber String   @unique // e.g. INV-2026-000123, auto-generated sequential
  issuedTo      String // snapshot of user name/email at time of invoice
  lineItems     Json // [{ description, amount }]
  totalAmount   Decimal  @db.Decimal(10, 2)
  pdfUrl        String? // populated later when PDF generation is added
  createdAt     DateTime @default(now())
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  processedBy String // AdminUser id
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

// --- Prompt 5: Content Management (default chart-of-accounts/category
// templates seeded into new workspaces, i18n strings, announcements, legal
// docs). ---

model DefaultAccountTemplate {
  id             String                   @id @default(uuid())
  name           String // e.g. "Cash", "Bank", "Sales Income", "Rent Expense"
  nameBn         String // Bangla translation
  accountType    AccountType
  accountSubtype String? // e.g. "cash", "bank", "mfs", "receivable", "payable"
  parentId       String?
  parent         DefaultAccountTemplate?  @relation("ParentChild", fields: [parentId], references: [id])
  children       DefaultAccountTemplate[] @relation("ParentChild")
  appliesTo      WorkspaceType[] // which workspace types get this by default: PERSONAL, BUSINESS
  displayOrder   Int                      @default(0)
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  categories     DefaultCategory[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

model DefaultCategory {
  id                      String                  @id @default(uuid())
  name                    String
  nameBn                  String
  type                    CategoryDirection // INCOME or EXPENSE
  icon                    String? // icon identifier string, e.g. "utensils", "car"
  linkedAccountTemplateId String?
  linkedAccountTemplate   DefaultAccountTemplate? @relation(fields: [linkedAccountTemplateId], references: [id])
  isActive                Boolean                 @default(true)
  displayOrder            Int                     @default(0)
}

enum CategoryDirection {
  INCOME
  EXPENSE
}

model TranslationString {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "dashboard.total_income"
  en        String
  bn        String
  context   String? // e.g. "dashboard", "auth", "reports" -- for grouping in the admin UI
  updatedAt DateTime @updatedAt
  updatedBy String? // AdminUser id
}

model Announcement {
  id         String           @id @default(uuid())
  title      String
  titleBn    String?
  body       String
  bodyBn     String?
  type       AnnouncementType
  targetPlan String? // SubscriptionPlan.id, null = all users
  startAt    DateTime
  endAt      DateTime?
  isActive   Boolean          @default(true)
  createdBy  String // AdminUser id
  createdAt  DateTime         @default(now())
}

enum AnnouncementType {
  INFO
  WARNING
  PROMOTION
  MAINTENANCE
}

model LegalDocument {
  id        String       @id @default(uuid())
  type      LegalDocType @unique
  contentEn String       @db.Text
  contentBn String?      @db.Text
  version   Int          @default(1)
  updatedAt DateTime     @updatedAt
  updatedBy String?
}

enum LegalDocType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  REFUND_POLICY
  FAQ
}

// --- Prompt 6: Support (tickets, ticket messages, feature requests + votes). ---

model SupportTicket {
  id                String          @id @default(uuid())
  platformUserId    String
  subject           String
  category          TicketCategory
  priority          TicketPriority  @default(MEDIUM)
  status            TicketStatus    @default(OPEN)
  assignedToAdminId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resolvedAt        DateTime?
  messages          TicketMessage[]

  @@index([status, priority])
  @@index([platformUserId])
}

enum TicketCategory {
  BILLING
  TECHNICAL
  ACCOUNT
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id])
  senderType    SenderType
  senderId      String // AdminUser id or PlatformUser id depending on senderType
  message       String        @db.Text
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum SenderType {
  ADMIN
  USER
}

model FeatureRequest {
  id             String               @id @default(uuid())
  platformUserId String
  title          String
  description    String               @db.Text
  status         FeatureRequestStatus @default(SUBMITTED)
  voteCount      Int                  @default(1)
  createdAt      DateTime             @default(now())
}

enum FeatureRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model FeatureRequestVote {
  id               String   @id @default(uuid())
  featureRequestId String
  platformUserId   String
  createdAt        DateTime @default(now())

  @@unique([featureRequestId, platformUserId])
}

// --- Prompt 7: Analytics (raw usage events + rolled-up daily snapshots). ---

model UsageEvent {
  id             String     @id @default(uuid())
  platformUserId String
  eventType      String // e.g. "income_added", "expense_added", "report_viewed", "budget_created", "login"
  metadata       Json? // flexible extra data, e.g. { "reportType": "profit_loss" }
  deviceType     DeviceType
  country        String? // for geographic breakdown
  city           String?
  createdAt      DateTime   @default(now())

  @@index([platformUserId, createdAt])
  @@index([eventType])
  @@index([country])
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

model DailyActiveSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  dailyActive Int
  newSignups  Int
  totalUsers  Int
  createdAt   DateTime @default(now())
}

// --- Prompt 8: Security & Audit (login attempts, suspicious activity flags). ---

model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String? // e.g. "invalid_password", "account_suspended", "rate_limited"
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SuspiciousActivityFlag {
  id             String                  @id @default(uuid())
  type           SuspiciousActivityType
  description    String
  relatedAdminId String?
  relatedIp      String?
  severity       Severity                @default(MEDIUM)
  status         FlagStatus              @default(OPEN)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([status, severity])
}

enum SuspiciousActivityType {
  MULTIPLE_FAILED_LOGINS
  UNUSUAL_LOGIN_LOCATION
  MASS_DATA_ACCESS
  IMPERSONATION_SPIKE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FlagStatus {
  OPEN
  REVIEWING
  RESOLVED
  FALSE_POSITIVE
}

// --- Prompt 9: System/Technical Management (backups, feature flags, error
// logs, API rate-limit monitoring). Everything here is simulated/manual-
// trigger rather than wired to real infrastructure -- see the module-level
// comment in system.module.ts for what's a stand-in vs. production-ready. ---

model BackupRecord {
  id           String       @id @default(uuid())
  triggeredBy  String // AdminUser id, or "SYSTEM" for scheduled
  type         BackupType
  status       BackupStatus
  sizeMb       Float?
  fileLocation String? // placeholder path/URL, real storage wiring comes later
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@index([startedAt])
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // e.g. "new_dashboard_ui", "ai_categorization_beta"
  name           String
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0) // 0-100, for gradual rollout
  targetPlanIds  String[] // empty = all plans
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

model ErrorLog {
  id           String      @id @default(uuid())
  source       ErrorSource
  message      String
  stackTrace   String?     @db.Text
  severity     Severity // reused from Prompt 8 -- same schema file
  metadata     Json?
  resolved     Boolean     @default(false)
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([resolved, severity])
  @@index([source, createdAt])
}

enum ErrorSource {
  BACKEND_API
  ADMIN_FRONTEND
  BACKGROUND_JOB
}

model ApiRateLimitLog {
  id             String   @id @default(uuid())
  endpoint       String
  windowStart    DateTime
  requestCount   Int
  limitExceeded  Boolean  @default(false)
  identifierType String // "ip" or "admin" or "platform_user"
  identifier     String

  @@index([endpoint, windowStart])
  @@index([limitExceeded])
}

// --- Prompt 10: Notification Management. Sending is simulated -- no real
// email/SMS/push provider is wired up yet, see notifications.module.ts. ---

model NotificationTemplate {
  id        String              @id @default(uuid())
  key       String              @unique // e.g. "subscription_expiring", "payment_failed", "welcome"
  channel   NotificationChannel
  subjectEn String? // for email
  subjectBn String?
  bodyEn    String              @db.Text
  bodyBn    String              @db.Text
  variables String[] // e.g. ["userName", "planName", "expiryDate"] -- documents what {{placeholders}} are available
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP_PUSH
}

model NotificationLog {
  id             String                @id @default(uuid())
  platformUserId String
  templateKey    String
  channel        NotificationChannel
  status         NotificationLogStatus
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())

  @@index([platformUserId, createdAt])
  @@index([templateKey])
}

enum NotificationLogStatus {
  QUEUED
  SENT
  FAILED
}

model BulkNotificationCampaign {
  id           String              @id @default(uuid())
  title        String
  templateKey  String
  targetFilter Json // e.g. { "planId": "xxx", "status": "ACTIVE" } -- describes who it goes to
  channel      NotificationChannel
  status       CampaignStatus      @default(DRAFT)
  scheduledFor DateTime?
  sentCount    Int                 @default(0)
  failedCount  Int                 @default(0)
  createdBy    String
  createdAt    DateTime            @default(now())
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

// =====================================================================
// END-USER APP (separate 20-prompt plan). Same database/schema file as
// the admin panel above -- extended here, not forked. Prompt 1: identity
// (User) + workspace (Business/BusinessMember) only. Account/Transaction/
// Contact tables come in later prompts.
// =====================================================================

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  preferredLanguage LanguagePreference @default(EN)
  status            UserStatus         @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       BusinessMember[]
  ownedBusinesses   Business[]         @relation("BusinessOwner")

  // No separate @@index([email]) -- @unique above already creates a unique
  // index covering lookups by email (same reasoning as AdminUser/PlatformUser).
}

enum LanguagePreference {
  EN
  BN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Business {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation("BusinessOwner", fields: [ownerId], references: [id])
  name      String
  type      WorkspaceType // reuses the enum already defined for DefaultAccountTemplate.appliesTo above
  currency  String        @default("BDT")
  planId    String?
  plan      SubscriptionPlan? @relation(fields: [planId], references: [id])
  isDefault Boolean       @default(false) // true for the auto-created personal workspace
  // Soft-delete only -- a workspace may hold financial data in later prompts,
  // so it's never hard-deleted. null = active. Every list/lookup query must
  // filter deletedAt: null.
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   BusinessMember[]

  @@index([ownerId])
}

model BusinessMember {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  role       MemberRole   @default(OWNER)
  invitedAt  DateTime?
  joinedAt   DateTime     @default(now())
  status     MemberStatus @default(ACTIVE)

  // @@unique below already gives an index with businessId as its leftmost
  // column (covers "all members of a business" lookups), so only userId
  // needs its own separate index here.
  @@unique([businessId, userId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  ACCOUNTANT
  STAFF
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}
