# __DOMAIN__ -- Cashfo. Rendered by attach-site.sh (and re-checked by
# ensure-site.sh) into /opt/smartly/nginx/__DOMAIN__.conf, which is bind
# mounted into hatim_backend-nginx-1 as conf.d/__DOMAIN__.conf.
#
# One upstream: smartly-web. It serves the panel, and passes better-auth's
# public endpoints (/api/auth/*: Google sign-in, the Infra dashboard) on to
# the API over the stack's internal network. The API itself is not reachable
# from here.

server {
    listen 80;
    server_name __DOMAIN__;

    # Above the redirect, or renewals start failing silently in 90 days.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The app sets none of these itself, so nothing is sent twice. A location
    # with its own add_header (the updating page) does not inherit them.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Avatar and contact-photo uploads pass through the panel.
    client_max_body_size 10m;

    # Next answers with large headers (auth cookies, preload links); the
    # default 4k buffer turns that into a 502.
    proxy_buffer_size       16k;
    proxy_buffers           8 16k;
    proxy_busy_buffers_size 32k;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Docker's embedded DNS. Needed because the upstream host is held in a
    # variable: with a literal hostname nginx resolves it while LOADING the
    # config, so a stopped smartly-web would fail `nginx -t` and a restart of
    # this proxy -- taking every other site down with it. Through a variable,
    # a stopped container is a 502 on this name only.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # A release replaces the containers, and for those few seconds nginx cannot
    # reach them. Visitors get a notice that reloads itself instead of a bare
    # "502 Bad Gateway". Only nginx's own errors land here; the app's own 502s
    # and 503s pass through untouched (proxy_intercept_errors stays off).
    error_page 502 504 = @smartly_updating;
    location @smartly_updating {
        default_type text/html;
        add_header Retry-After 10 always;
        add_header Cache-Control "no-store" always;
        return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="8"><title>Updating</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#f8fafc;color:#0f172a}main{text-align:center;padding:2rem}h1{font-size:1.25rem;margin:0 0 .5rem}p{margin:0;color:#475569}</style></head><body><main><h1>Updating</h1><p>This page will reload in a few seconds.</p></main></body></html>';
    }

    # Content-hashed build output. Next already sends a year-long immutable
    # Cache-Control for it; this only keeps it out of the access log.
    location /_next/static/ {
        set $smartly_web smartly-web;
        proxy_pass http://$smartly_web:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        set $smartly_web smartly-web;
        proxy_pass http://$smartly_web:3000;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Appended, so its last entry is the address nginx saw, whatever the
        # client wrote into the header itself. The panel forwards the chain to
        # the API, whose TRUST_PROXY picks that entry for the login throttle,
        # login history and sessions.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
