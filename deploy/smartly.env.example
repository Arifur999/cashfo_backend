# /opt/smartly/.env -- written by bootstrap.sh (secrets generated on the
# server), read by docker-compose.yml. Mode 600; never copy it anywhere.
# Change values with: bash set-env.sh KEY [KEY ...]

# The public name, and where the two images come from. Pin an image to a
# commit (ghcr.io/...:<sha>) to hold a release back.
DOMAIN=smartly.softech.agency
API_IMAGE=ghcr.io/arifur999/cashfo_backend:latest
WEB_IMAGE=ghcr.io/arifur999/cashfo:latest

# The first super admin, created once by install.sh. Signs in with this
# password, or with Google when the address is a Google account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=

# Generated by bootstrap.sh.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
USER_JWT_SECRET=
USER_JWT_REFRESH_SECRET=
USAGE_TRACKING_API_KEY=
VAULT_ENCRYPTION_KEY=
VAULT_TOKEN_SECRET=

# Outside services; empty turns the feature off. Set them with set-env.sh.
# Google sign-in: the OAuth client's redirect URI must be
# https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth Infra dashboard (dash.better-auth.com).
BETTER_AUTH_API_KEY=
# Email (welcome, password reset). onboarding@resend.dev only reaches the
# Resend account's own address until a sending domain is verified.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
# Avatar uploads.
IMGBB_API_KEY=

# Database backups (cron, UTC): 21:00 UTC is 03:00 in Dhaka.
BACKUP_SCHEDULE=0 21 * * *
BACKUP_RETENTION_DAYS=14
